# ==============================================================================
# @module  comment-builder.yml
# @about   Модуль приема сигнала от Конструктора комментариев.
# @purpose Проверка сквозной передачи события comment-notify из techlab-comment-builder.
# @author  TechLab
# @version 1.0.0
# ==============================================================================

name: TechLab Comment Builder Receiver

on:
  repository_dispatch:
    types: [comment-notify]

jobs:
  test_signal:
    runs-on: ubuntu-latest
    steps:
      - name: Signal Received Successfully
        run: |
          echo "========================================================"
          echo "[УСПЕХ] Сигнал 'comment-notify' успешно принят."
          echo "Связь между репозиториями установлена."
          echo "Конструктор комментариев подготовил пакет и ожидает его приема."
          echo "========================================================"
