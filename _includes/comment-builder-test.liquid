{%- comment -%}
@module  comment-builder-test.liquid
@about   Тестовый шаблон разметки Конструктора комментариев.
@purpose Проверка разметки авторизации, рабочей области, шапки комментария, черновиков, текстовых и медиаблоков.
@author  TechLab
@version 1.1.0
{%- endcomment -%}

<div class="admin-container">
  <!-- БЛОК АВТОРИЗАЦИИ ПО ТОКЕНУ GITHUB -->
  <div id="auth-section" class="auth-box">
    <h3 class="auth-title">🔑 Доступ к конструктору</h3>
    <p class="auth-desc">Вставьте ваш личный ключ доступа (ghp_), чтобы открыть конструктор:</p>
    <input type="password" id="token-input" class="input-text" placeholder="ghp_...">
    <button id="btn-login" class="btn-big btn-auth" onclick="submitToken()">🔓 Подключить конструктор</button>
  </div>

  <!-- ПОЯСНЕНИЕ ПО ИСПОЛЬЗОВАНИЮ ТОКЕНА -->
  <div id="instructions-section" class="auth-box margin-top-15" style="font-size: 13px; color: #6c757d;">
    <p style="margin: 0;">Используйте ваш персональный токен доступа GitHub (PAT) для авторизации в системе.</p>
  </div>

  <!-- РАБОЧАЯ ОБЛАСТЬ КОНСТРУКТОРА: СКРЫТА ДО УСПЕШНОЙ АВТОРИЗАЦИИ -->
  <div id="journal-section" class="hidden">
    <!-- СТАТУСНЫЕ СООБЩЕНИЯ КОНСТРУКТОРА -->
    <div id="notification" class="notify"></div>

    <!-- БЛОК 1: ПАРАМЕТРЫ КОММЕНТАРИЯ -->
    <div class="block margin-top-15">
      <h3 style="margin-top: 0; margin-bottom: 10px; color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px; font-size: 16px;">1. Параметры комментария</h3>
      
      <!-- СТРОКА 1: ДАТА, НОМЕР ОБСУЖДЕНИЯ И КОРОТКИЙ ИДЕНТИФИКАТОР КОММИТА -->
      <div class="header-line" style="display: flex; align-items: center; gap: 6px; margin-bottom: 10px;">
        <input type="text" id="target-date" class="input-date" maxlength="10" value="" placeholder="YYYY-MM-DD" style="width: 100px !important; text-align: center; font-family: monospace;">             
        <span class="inline-label" style="margin-left: auto; font-weight: bold; font-size: 15px; color: #444;">🗣️:</span>
        <input type="text" id="discussion-combo" class="input-disc" maxlength="3" value="" placeholder="№" style="width: 38px !important; text-align: center; font-family: monospace;">
        <span class="inline-label" style="font-weight: bold; font-size: 15px; color: #444;">-</span>
        <input type="text" id="commit-id" class="input-commit" maxlength="8" value="" placeholder="коммит" style="width: 82px !important; text-align: center; font-family: monospace;">
      </div>

      <!-- СТРОКА 2: ВЫБОР ЧЕРНОВИКА И ПЕРЕКЛЮЧАТЕЛЬ РЕЖИМА ЧЕРНОВИКОВ -->
      <div class="header-line" style="display: flex; align-items: center; gap: 6px;">
        <div class="draft-select-container" style="flex: 1;">
          <select id="draft-select" disabled style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 15px; background: #fff;" onchange="if(typeof loadDraftData === 'function') loadDraftData(this.value)">
            <option value="">Выберите черновик --></option>
          </select>
        </div>
        <label class="draft-trigger" style="display: flex; align-items: center; cursor: pointer; user-select: none;">
          <input type="checkbox" id="is-draft-mode" style="width: 22px; height: 22px; cursor: pointer; margin: 0;" onchange="if(typeof toggleDraftBehavior === 'function') toggleDraftBehavior();">
        </label>
      </div>
    </div>

    <!-- БЛОК 2: ТЕКСТ КОММЕНТАРИЯ -->
    <div class="block margin-top-15">
      <h3 style="margin-top: 0; margin-bottom: 10px; color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px; font-size: 16px;">2. Структура комментария</h3>
      <input type="text" id="post-title" placeholder="Заголовок комментария (если есть)" style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; font-size: 15px; background: #fff; margin-bottom: 10px;">
      <textarea id="post-text" rows="5" placeholder="Описание комментария: основной текст, например, что было сделано или создано на занятии..." style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; font-size: 15px; background: #fff; margin-bottom: 10px;"></textarea>
      <textarea id="post-footer" rows="3" placeholder="Подвал комментария: дополнительные сведения, автор, метки, ссылки..." style="width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; font-size: 15px; background: #fff; margin-bottom: 0;"></textarea>
    </div>

    <!-- БЛОК 3: ФОТОМАТЕРИАЛЫ -->
    <div class="block margin-top-15">
      <h3 style="margin-top: 0; margin-bottom: 10px; color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px; font-size: 16px;">3. 📸 Фотоматериалы</h3>
      <div id="photos-meta-container"></div>
      <button type="button" class="btn-add" style="background: #fff; color: #0076ff; border: 1px dashed #0076ff; padding: 8px; font-size: 14px; border-radius: 4px; cursor: pointer; width: 100%; font-weight: bold; margin-top: 5px;" onclick="addPhotoBlock()">+ Добавить блок фото</button>
    </div>

    <!-- БЛОК 4: ВИДЕОМАТЕРИАЛЫ -->
    <div class="block margin-top-15">
      <h3 style="margin-top: 0; margin-bottom: 10px; color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px; font-size: 16px;">4. 🎥 Видеоматериалы</h3>
      <div id="videos-meta-container"></div>
      <button type="button" class="btn-add btn-add-video" style="background: #fff; color: #ff9500; border: 1px dashed #ff9500; padding: 8px; font-size: 14px; border-radius: 4px; cursor: pointer; width: 100%; font-weight: bold; margin-top: 5px;" onclick="addVideoBlock()">+ Добавить блок видео</button>
    </div>

    <!-- БЛОК УПРАВЛЕНИЯ СОХРАНЕНИЕМ И ПУБЛИКАЦИЕЙ -->
    <div class="block margin-top-15" style="background: #f0f7ff; border-color: #b3d7ff;">
      <div style="display: flex; align-items: center; gap: 6px; font-weight: bold; font-size: 15px; color: #0056b3; margin-bottom: 12px; cursor: pointer; user-select: none;">
        <input type="checkbox" id="publish-now-flag" checked onchange="if(typeof updatePublishLabel === 'function') updatePublishLabel();"> 
        <span id="publish-label-text">🔥 Опубликовать сейчас (published: true)</span>
      </div>
      <button type="button" class="btn" id="submit-btn" style="background: #0076ff; color: #fff; border: none; padding: 12px; font-size: 16px; border-radius: 6px; cursor: pointer; width: 100%; font-weight: bold;" onclick="handleCommentSubmit()">Создать комментарий</button>
    </div>
  </div>
</div>

<!-- ПОДКЛЮЧЕНИЕ JS-МОДУЛЕЙ КОНСТРУКТОРА -->

<!-- 1. СЕРВИСНЫЕ УВЕДОМЛЕНИЯ -->
<script src="{{ '/assets/js/comment-builder/00-comment-notify.js' | relative_url }}"></script>

<!-- 2. АВТОРИЗАЦИЯ И ИНИЦИАЛИЗАЦИЯ ИНТЕРФЕЙСА -->
<script src="{{ '/assets/js/comment-builder/01-comment-auth.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/02-comment-ui.js' | relative_url }}"></script>

<!-- 3. ЗАГРУЗКА, РАЗБОР И ВОССТАНОВЛЕНИЕ ЧЕРНОВИКОВ -->
<script src="{{ '/assets/js/comment-builder/03-drafts-loader.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/04-drafts-parser.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/05-drafts-injector.js' | relative_url }}"></script>

<!-- 4. ПРОВЕРКА ДАННЫХ, РАБОТА С МЕДИА И СОХРАНЕНИЕ -->
<script src="{{ '/assets/js/comment-builder/06-comment-validation.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/07-media-files.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/08-comment-lock.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/09-media-upload.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/10-comment-save.js' | relative_url }}"></script>
