{%- comment -%}
@module  comment-builder.liquid
@about   Модуль шаблона интерфейса Конструктора комментариев.
@purpose Двухлинейная компактная CMS-шапка публикации, ведение черновиков и отправка медиа-пакетов.
@author  TechLab
@version 2.0.0
{%- endcomment -%}

<div class="block">
  <h3>1. Параметры коментария</h3>
  
  <!-- ЛИНИЯ 1: Монолитная строка параметров публикации (Дата + Дискуссия-Коммит через дефис) -->
  <div class="header-line">
    <input type="text" id="target-date" class="input-date" maxlength="10" value="2026-10-25" placeholder="YYYY-MM-DD" onchange="updateNormalDateValue(this.value)">             
    <span class="inline-label" style="margin-left: auto;">🗣️:</span>
    <input type="text" id="discussion-combo" class="input-disc" maxlength="3" value="" placeholder="№">
    <span class="inline-label">-</span>
    <input type="text" id="commit-id" class="input-commit" maxlength="8" value="" placeholder="коммит">
  </div>

  <!-- ЛИНИЯ 2: Поле черновиков на всю ширину + Бестекстовая галочка-индикатор -->
  <div class="header-line">
    <div class="draft-select-container">
      <select id="draft-select" onchange="loadDraftData(this.value)">
        <!-- Наполняется скриптом из comment-builder.js -->
      </select>
    </div>
    
    <label class="draft-trigger">
      <input type="checkbox" id="is-draft-mode" onchange="toggleDraftBehavior()">
    </label>
  </div>
</div>

<!-- БЛОК 2: КОНТЕКСТ ОТЧЕТА -->
<div class="block">
  <h3>2. Структура комментария</h3>
  <input type="text" id="post-title" placeholder="Заголовок комментария (если есть)">
  <textarea id="post-text" rows="5" placeholder="Описание комментария: основной текст, например, что было сделано или создано на занятии..."></textarea>
  <textarea id="post-footer" rows="3" placeholder="Подвал комментария: дополнительные сведения, автор, метки, ссылки..."></textarea>
</div>

<!-- БЛОК 3: ФОТОМАТЕРИАЛЫ -->
<div class="block">
  <h3>3. 📸 Фотоматериалы</h3>
  <div id="photos-meta-container"></div>
  <button type="button" class="btn-add" onclick="addPhotoBlock()">+ Добавить блок фото</button>
</div>

<!-- БЛОК 4: ВИДЕОМАТЕРИАЛЫ -->
<div class="block">
  <h3>4. 🎥 Видеоматериалы</h3>
  <div id="videos-meta-container"></div>
  <button type="button" class="btn-add btn-add-video" onclick="addVideoBlock()">+ Добавить блок видео</button>
</div>

<!-- БЛОК КОНТРОЛЯ -->
<div class="block" style="background: #f0f7ff; border-color: #b3d7ff;">
  <div style="display: flex; align-items: center; gap: 6px; font-weight: bold; font-size: 15px; color: #0056b3; margin-bottom: 12px; cursor: pointer; user-select: none;">
    <input type="checkbox" id="publish-now-flag" checked onchange="updatePublishLabel()"> 
    <span id="publish-label-text">🔥 Опубликовать сейчас (published: true)</span>
  </div>
  <button type="button" class="btn" id="submit-btn" onclick="generateMarkdownOutput()">Создать комментарий</button>
</div>

<!-- ПОДКЛЮЧЕНИЕ ВЫДЕЛЕННОГО СКРИПТА СТРОГО ПО РЕГЛАМЕНТУ CMS TECHLAB -->
<script src="{{ '/assets/js/comment-builder/comment-builder.js' | relative_url }}"></script>
