{%- comment -%}
@module  comment-builder.liquid
@about   Тестовый шаблон разметки Конструктора комментариев.
@purpose Проверка разметки авторизации, рабочей области, шапки комментария, черновиков, текстовых и медиаблоков.
@author  TechLab
@version 1.0.0
{%- endcomment -%}

<div class="comment-builder">
  <!-- БЛОК АВТОРИЗАЦИИ ПО ТОКЕНУ GITHUB -->
  <div id="auth-section" class="auth-box">
    <h3 class="auth-title">🔑 Доступ к конструктору</h3>
    <p class="auth-desc">Вставьте ваш личный ключ доступа (ghp_), чтобы открыть конструктор:</p>
    <input type="password" id="token-input" class="input-text" placeholder="ghp_...">
    <button id="btn-login" class="btn-big btn-auth" onclick="submitToken()">🔓 Подключить конструктор</button>
  </div>

  <!-- ПОЯСНЕНИЕ ПО ИСПОЛЬЗОВАНИЮ ТОКЕНА -->
  <div id="instructions-section" class="auth-box margin-top-15 token-instructions">
    <p class="token-instructions-text">Используйте ваш персональный токен доступа GitHub (PAT) для авторизации в системе.</p>
  </div>

  <!-- РАБОЧАЯ ОБЛАСТЬ КОНСТРУКТОРА: СКРЫТА ДО УСПЕШНОЙ АВТОРИЗАЦИИ -->
  <div id="journal-section" class="hidden">
    <!-- СТАТУСНЫЕ СООБЩЕНИЯ КОНСТРУКТОРА -->
    <div id="notification" class="notify"></div>

    <!-- БЛОК 1: ПАРАМЕТРЫ КОММЕНТАРИЯ -->
    <div class="block margin-top-15">
      <h3>1. Параметры комментария</h3>
      
      <!-- СТРОКА 1: ДАТА, НОМЕР ОБСУЖДЕНИЯ И КОРОТКИЙ ИДЕНТИФИКАТОР КОММИТА -->
      <div class="header-line">
        <input type="text" id="target-date" class="input-date" maxlength="10" value="" placeholder="YYYY-MM-DD">             
        <span class="inline-label header-label-spacer">🗣️:</span>
        <input type="text" id="discussion-combo" class="input-disc" maxlength="3" value="" placeholder="№">
        <span class="inline-label">-</span>
        <input type="text" id="commit-id" class="input-commit" maxlength="8" value="" placeholder="коммит">
      </div>

      <!-- СТРОКА 2: ВЫБОР ЧЕРНОВИКА И ПЕРЕКЛЮЧАТЕЛЬ РЕЖИМА ЧЕРНОВИКОВ -->
      <div class="header-line">
        <div class="draft-select-container">
          <select id="draft-select" disabled onchange="if(typeof loadDraftData === 'function') loadDraftData(this.value)">
            <option value="">Выберите черновик --></option>
          </select>
        </div>
        <label class="draft-trigger">
          <input type="checkbox" id="is-draft-mode" onchange="if(typeof toggleDraftBehavior === 'function') toggleDraftBehavior();">
        </label>
      </div>
    </div>

    <!-- БЛОК 2: ТЕКСТ КОММЕНТАРИЯ -->
    <div class="block margin-top-15">
      <h3>2. Структура комментария</h3>
      <input type="text" id="post-title" placeholder="Заголовок комментария (если есть)">
      <textarea id="post-text" rows="5" placeholder="Описание комментария: основной текст, например, что было сделано или создано на занятии..."></textarea>
      <textarea id="post-footer" rows="3" placeholder="Подвал комментария: дополнительные сведения, автор, метки, ссылки..."></textarea>
    </div>

    <!-- БЛОК 3: ФОТОМАТЕРИАЛЫ -->
    <div class="block margin-top-15">
      <h3>3. 📸 Фотоматериалы</h3>
      <div id="photos-meta-container"></div>
      <button type="button" class="btn-add" onclick="addPhotoBlock()">+ Добавить блок фото</button>
    </div>

    <!-- БЛОК 4: ВИДЕОМАТЕРИАЛЫ -->
    <div class="block margin-top-15">
      <h3>4. 🎥 Видеоматериалы</h3>
      <div id="videos-meta-container"></div>
      <button type="button" class="btn-add btn-add-video" onclick="addVideoBlock()">+ Добавить блок видео</button>
    </div>

    <!-- БЛОК УПРАВЛЕНИЯ СОХРАНЕНИЕМ И ПУБЛИКАЦИЕЙ -->
    <div class="block margin-top-15 publish-block">
      <div class="publish-option">
        <input type="checkbox" id="publish-now-flag" onchange="if(typeof updatePublishLabel === 'function') updatePublishLabel();"> 
        <span id="publish-label-text">Опубликовать</span>
        <span class="publish-bot-option">
          <input type="checkbox" id="publish-as-bot-flag">
          <span>Робот</span>
        </span>
        <span id="delete-draft-option" class="publish-delete-option" title="Пометить черновик на удаление">
          <input type="checkbox" id="delete-draft-flag" disabled>
          🗑️
        </span>
      </div>
      <button type="button" class="btn" id="submit-btn" onclick="handleCommentSubmit()">Сохранить черновик</button>
    </div>
  </div>
</div>

<!-- ПОДКЛЮЧЕНИЕ JS-МОДУЛЕЙ КОНСТРУКТОРА -->

<!-- 1. СЕРВИСНЫЕ УВЕДОМЛЕНИЯ -->
<script src="{{ '/assets/js/comment-builder/00-comment-notify.js' | relative_url }}"></script>

<!-- 2. АВТОРИЗАЦИЯ И ИНИЦИАЛИЗАЦИЯ ИНТЕРФЕЙСА -->
<script src="{{ '/assets/js/comment-builder/01-comment-auth.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/02-comment-ui.js' | relative_url }}"></script>

<!-- 3. ЗАГРУЗКА, РАЗБОР И ВОССТАНОВЛЕНИЕ ЧЕРНОВИКОВ -->
<script src="{{ '/assets/js/comment-builder/03-drafts-loader.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/04-drafts-parser.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/05-drafts-injector.js' | relative_url }}"></script>

<!-- 4. ПРОВЕРКА ДАННЫХ, РАБОТА С МЕДИА И СОХРАНЕНИЕ -->
<script src="{{ '/assets/js/comment-builder/06-comment-validation.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/07-media-files.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/08-comment-lock.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/09-media-upload.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/10-comment-save.js' | relative_url }}"></script>
<script src="{{ '/assets/js/comment-builder/11-drafts-delete.js' | relative_url }}"></script>
