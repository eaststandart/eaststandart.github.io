<script>
(function () {
    const fixGiscusFullscreen = function () {
        const frame = Array.from(document.querySelectorAll("iframe"))
            .find(function (iframe) {
                return iframe.src.includes("giscus");
            });

        if (!frame) return false;

        const allow = frame.getAttribute("allow") || "";
        const permissions = allow.split(";").map(function (item) {
            return item.trim();
        });

        if (!permissions.includes("fullscreen") || !frame.hasAttribute("allowfullscreen")) {
            frame.setAttribute("allow", (allow ? allow + "; " : "") + "fullscreen");
            frame.setAttribute("allowfullscreen", "");
            frame.src = frame.src;
        }

        observer.disconnect();
        return true;
    };

    const observer = new MutationObserver(fixGiscusFullscreen);

    if (!fixGiscusFullscreen()) {
        observer.observe(document.documentElement, {
            childList: true,
            subtree: true
        });
    }
})();
</script>

