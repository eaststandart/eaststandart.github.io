{%- comment -%}
@about Универсальный модуль автоматической генерации сеток разделов сайта.
@purpose Собирает все страницы текущего раздела и выводит их в виде карточек,
         полностью отсекая технические архивы по общему системному маркеру posttype.
@author TechLab
{%- endcomment -%}

<div class="faire-list">
  {% assign current_section = page.url %}
  {% assign raw_projects = site.pages | where_exp: "item", "item.url contains current_section" | sort: "date" | reverse %}
  
  {% for project in raw_projects %}
    {% comment %} УНИВЕРСАЛЬНЫЙ БАРЬЕР: Пропускаем технические архивные страницы под кнопку 0 {% endcomment %}
    {% if project.posttype != 'post-page-open' %}
      {% unless project.url == current_section %}
        <a href="{{ project.url | relative_url }}" class="faire-card">
          {% assign folder = project.url | split: "/" | last %}
          <img src="{{ project.url | append: folder | append: '.webp' | relative_url }}" class="faire-img-round">
          <h3>{{ project.title }}</h3>
        </a>
      {% endunless %}
    {% endif %}
  {% endfor %}
</div>
