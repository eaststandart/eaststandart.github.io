{%- comment -%}
@about Сборка ленты на основе квантованных страниц Питона с сохранением 100% оригинальных стилей.
@purpose Рендерит все страницы раздельно, сохраняя ваши канонические цвета ссылок.
@author TechLab 
{%- endcomment -%}

{%- assign current_path_clean = page.url | strip_search | strip_slash -%}
{%- assign url_parts = current_path_clean | split: "/" -%}
{%- assign current_section = url_parts | last | strip | downcase -%}

{%- if include.type == "home" or current_section == "news" -%}
  {%- assign target_basket = site.data.feed.news -%}
{%- else -%}
  {%- assign target_basket = site.data.feed[current_section] -%}
{%- endif -%}

{% comment %} Обходим пронумерованные страницы, созданные Питоном {% endcomment %}
{%- for page_hash in target_basket.pages -%}
  {%- assign page_num = page_hash[0] -%}
  {%- assign page_items = page_hash[1] -%}

  <!-- Оболочка страницы пагинации. Первая видна всегда, остальные изначально скрыты -->
  <div class="feed-page-block" data-page="{{ page_num }}" {% if page_num != 1 and page_num != "1" %}style="display: none;"{% endif %}>
    
    {%- for item in page_items -%}
      {%- assign pinned_class = "" -%}
      {%- if item.pinned == true or item.pinned == "true" -%}
        {%- assign pinned_class = " pinned-item" -%}
      {%- endif -%}

      {%- if include.type == "home" -%}
        <!-- Вариант А: ВАШИ ОРИГИНАЛЬНЫЕ СТИЛИ ДЛЯ ГЛАВНОЙ СТРАНИЦЫ -->
        <li class="news-item news-item-compact{{ pinned_class }}" data-date="{{ item.date }}" data-is-post="{{ item.is_post }}">
          <div>
            <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
            <span>
              <a href="{{ item.url | relative_url }}" class="item-link">
                {{ item.title }}{% if item.emoji and item.emoji != "" %} {{ item.emoji }}{% endif %}
              </a>
            </span>
          </div>
        </li>
        
      {%- elsif include.type == "feed" -%}
        <!-- Вариант Б: ВАШИ ОРИГИНАЛЬНЫЕ СТИЛИ С ЛИНИЯМИ ДЛЯ ЖУРНАЛА -->
        <li class="news-item{{ pinned_class }}" data-date="{{ item.date }}" data-is-post="{{ item.is_post }}" style="margin-bottom: 12px; border-bottom: 1px solid #f0f0f0; padding-bottom: 8px;">
          <div>
            <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
            <span>
              <a href="{{ item.url | relative_url }}" class="item-link" style="text-decoration: none;">
                {{ item.title }}{% if item.personal_emoji and item.personal_emoji != "" %} {{ item.personal_emoji }}{% endif %}
              </a>
            </span>
          </div>
        </li>
      {%- endif -%}
    {%- endfor -%}

  </div>
{%- endfor -%}
