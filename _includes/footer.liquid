<!-- АВТОМАТИЧЕСКАЯ ЛЕНИВАЯ ЗАГРУЗКА ДЛЯ КАРТИНОК ИЗ MARKDOWN -->
<script>
  // Скрипт находит все картинки внутри основного контента и прописывает им ленивую загрузку
  document.querySelectorAll('.main-content img').forEach(function(img) {
    if (!img.hasAttribute('loading')) {
      img.setAttribute('loading', 'lazy');
    }
  });
</script>
