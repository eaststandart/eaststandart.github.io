{%- comment -%}
@module  journal-attendance.liquid
@about   Модуль шаблона интерфейса Журнала посещений.
@purpose Отображение формы авторизации по токену и генерация списков групп на странице сайта.
@author  TechLab
@version 1.0.0
{%- endcomment -%}

<div class="admin-container">
  <!-- БЛОК АВТОРИЗАЦИИ ЧЕРЕЗ ТОКЕН-ПАРОЛЬ -->
  <div id="auth-section" class="auth-box">
    <h3 class="auth-title">🔑 Доступ к журналу</h3>
    <p class="auth-desc">Вставьте ваш личный ключ доступа (ghp_), чтобы открыть журнал:</p>
    <input type="password" id="token-input" class="input-text" placeholder="ghp_...">
    <button id="btn-login" class="btn-big btn-auth" onclick="submitToken()">🔓 Подключить журнал</button>
  </div>

  <!-- РАБОЧАЯ ЗОНА ЖУРНАЛА -->
  <div id="journal-section" class="hidden">
    <!-- 1. Постоянный статус-бар -->
    <div id="notification" class="notify"></div>

    <!-- 2. Контейнер для динамических кнопок дней недели -->
    <div id="days-buttons-container" class="days-flex-container">
      <button id="btn-day-понедельник" class="btn-big btn-day btn-day-transition day-border-понедельник" disabled onclick="selectDynamicDay('понедельник')">ПН</button>
      <button id="btn-day-вторник" class="btn-big btn-day btn-day-transition day-border-вторник" disabled onclick="selectDynamicDay('вторник')">ВТ</button>
      <button id="btn-day-среда" class="btn-big btn-day btn-day-transition day-border-среда" disabled onclick="selectDynamicDay('среда')">СР</button>
      <button id="btn-day-четверг" class="btn-big btn-day btn-day-transition day-border-четверг" disabled onclick="selectDynamicDay('четверг')">ЧТ</button>
      <button id="btn-day-пятница" class="btn-big btn-day btn-day-transition day-border-пятница" disabled onclick="selectDynamicDay('пятница')">ПТ</button>
      <button id="btn-day-суббота" class="btn-big btn-day btn-day-transition day-border-суббота" disabled onclick="selectDynamicDay('суббота')">СБ</button>
      <button id="btn-day-воскресенье" class="btn-big btn-day btn-day-transition day-border-воскресенье" disabled onclick="selectDynamicDay('воскресенье')">ВС</button>
    </div>

    <!-- 3. Единый контейнер для управляемой даты дня --> 
    <div id="global-date-container"></div>

    <!-- 4. Контейнер для динамических групп занятий -->
    <div id="groups-container"></div>
 
    <!-- ПАМЯТКА ПО ЗАПОЛНЕНИЮ ДЛЯ ПРЕПОДАВАТЕЛЕЙ НА СТРАНИЦЕ УЧЕНИКОВ -->
    <details class="auth-box margin-top-15 regulation">
      <summary class="regulation-summary"><h4>Регламент работы с Журналом</h4></summary>
      <div class="regulation-content">
      <h4>💡 Правила заполнения полей ввода</h4>
      
      <p class="regulation-rule-heading">🧱 1. Правило ввода</p>
      <p class="regulation-rule-text">Учащиеся вносятся в строку строго через запятую.</p>
      <ul class="regulation-list">
        <li><b>Пример:</b> <code class="regulation-code">Фамилия Имя, Фамилия Имя, Фамилия Имя</code></li>
        <li><b>Пример:</b> <code class="regulation-code">Фамилия Имя, Фамилия Имя /с, Фамилия Имя /э /#</code></li>
      </ul>

      <p class="regulation-rule-heading">🧱 2. Структура записи</p>
      <p class="regulation-rule-text regulation-no-bottom">Каждая запись состоит строго из трех позиций в следующем порядке:<br>
      <code class="regulation-code-structure">[Фамилия Имя] [Ключ] [Тег]</code></p>

      <p class="regulation-rule-heading regulation-heading-tight">🧱 3. Ключи и Теги</p>
      <p class="regulation-note">Вводятся по необходимости, обязательными не являются.</p>
      
      <p class="regulation-subheading">🔹 Ключи направления:</p>
      <ul class="regulation-list">
        <li><b>/э</b> или <b>/e</b> — Электронное конструирование (Пример: <code class="regulation-code">Фамилия Имя /э</code>)</li>
        <li><b>/с</b> или <b>/c</b> — Столярное дело (Пример: <code class="regulation-code">Фамилия Имя /с</code>)</li>
      </ul>
      <p class="regulation-subheading">🔹 Ключи системные:</p>
      <ul class="regulation-list">
        <li><b>/d</b> — Удаление записи (Пример: <code class="regulation-code">journal Фамилия Имя /d</code>)</li>
        <li><b>/r</b> — Исправление ошибок (Пример: <code class="regulation-code">journal /r</code>)</li>
        <li><b>/m</b> — Модификация времени (Пример: <code class="regulation-code">journal 1200 1500 /m</code>)</li>
      </ul>
      <p class="regulation-subheading">🔹 Группы тегов:</p>
      <ul class="regulation-list">
        <li><b>#</b> — Автогенерация хэштега (Пример: <code class="regulation-code">Фамилия Имя /э /#</code>)</li>
        <li><b>@логин</b> — Логин GitHub (Пример: <code class="regulation-code">Фамилия Имя /с @login</code>)</li>
        <li><b>#techlab-familiya-imya</b> — Тег платформы (Пример: <code class="regulation-code">Фамилия Имя /с #techlab-familiya-imya</code>)</li>
      </ul>
      </div>
    </details>

  </div>
</div>

<!-- Сбор отметок посещаемости на сайте и отправка PUT-запросов JSON в репозиторий GitHub -->
<script src="{{ '/assets/js/journal-attendance/01-core-auth.js' | relative_url }}"></script>
<script src="{{ '/assets/js/journal-attendance/02-students-loader.js' | relative_url }}"></script>
<script src="{{ '/assets/js/journal-attendance/03-yaml-parser.js' | relative_url }}"></script>
<script src="{{ '/assets/js/journal-attendance/04-journal-ui.js' | relative_url }}"></script>
<script src="{{ '/assets/js/journal-attendance/05-attendance-commands.js' | relative_url }}"></script>
<script src="{{ '/assets/js/journal-attendance/06-status-and-repair.js' | relative_url }}"></script>
<script src="{{ '/assets/js/journal-attendance/07-validation.js' | relative_url }}"></script>
