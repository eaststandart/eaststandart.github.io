{%- comment -%}
@module journal-attendance.liquid
@about Шаблон интерфейса Журнала посещаемости
@purpose Отображение формы авторизации по токену и генерация списков групп на фронтенде
@author TechLab
@version 1.0.0
{%- endcomment -%}

<div class="admin-container">
  <!-- БЛОК АВТОРИЗАЦИИ ЧЕРЕЗ ТОКЕН-ПАРОЛЬ -->
  <div id="auth-section" class="auth-box">
    <h3 class="auth-title">🔑 Доступ к журналу</h3>
    <p class="auth-desc">Вставьте ваш личный ключ доступа (ghp_), чтобы открыть журнал:</p>
    <input type="password" id="token-input" class="input-text" placeholder="ghp_...">
    <button id="btn-login" class="btn-big btn-auth" onclick="submitToken()">🔓 Подключить журнал</button>
  </div>

  <!-- РАБОЧАЯ ЗОНА ЖУРНАЛА -->
  <div id="journal-section" class="hidden">
    <!-- 1. Постоянный статус-бар -->
    <div id="notification" class="notify"></div>

    <!-- 2. Контейнер для динамических кнопок дней недели -->
    <div id="days-buttons-container" class="days-flex-container"></div>

    <!-- 3. Единый контейнер для управляемой даты дня --> 
    <div id="global-date-container"></div>

    <!-- 4. Контейнер для динамических групп занятий -->
    <div id="groups-container"></div>
 
    <!-- ПАМЯТКА ПО ЗАПОЛНЕНИЮ ДЛЯ ПРЕПОДАВАТЕЛЕЙ НА СТРАНИЦЕ УЧЕНИКОВ -->
    <div class="auth-box margin-top-15" style="font-size: 13px; color: #495057; line-height: 1.6;">
      <h4 style="margin-top: 0; color: #24292e; font-size: 15px;">💡 Регламент заполнения полей ввода</h4>
      
      <p style="margin: 8px 0 4px 0; font-weight: bold;">1. Правило ввода</p>
      <p style="margin: 0 0 4px 0;">Учащиеся вносятся в строку строго через запятую.</p>
      <ul style="margin: 0; padding-left: 20px;">
        <li><b>Пример:</b> Фамилия Имя, Фамилия Имя, Фамилия Имя</li>
        <li><b>Пример:</b> Фамилия Имя, Фамилия Имя /с, Фамилия Имя /э /#</li>
      </ul>

      <p style="margin: 8px 0 4px 0; font-weight: bold;">2. Структура записи</p>
      <p style="margin: 0;">Каждая запись состоит строго из трех позиций в следующем порядке: <code style="background:#f1f3f5; padding:2px 4px; border-radius:4px; font-family:monospace;">[Фамилия Имя] [Ключ] [Тег]</code></p>

      <p style="margin: 8px 0 2px 0; font-weight: bold;">3. Ключи и Группы тегов</p>
      <p style="margin: 0 0 4px 0; font-style: italic; color: #6c757d;">Вводятся по необходимости, обязательными не являются.</p>
      
      <p style="margin: 4px 0 2px 0; font-weight: bold; color: #212529;">🔹 Ключи направления:</p>
      <ul style="margin: 0; padding-left: 20px;">
        <li><b>/э</b> или <b>/e</b> — Электронное конструирование (Пример: Фамилия Имя /э)</li>
        <li><b>/с</b> или <b>/c</b> — Столярное дело (Пример: Фамилия Имя /с)</li>
      </ul>

      <p style="margin: 4px 0 2px 0; font-weight: bold; color: #212529;">🔹 Ключ генерации тегов:</p>
      <ul style="margin: 0; padding-left: 20px;">
        <li><b>/#</b> — Автогенерация хэштега (Пример: Фамилия Имя /э /#)</li>
      </ul>

      <p style="margin: 4px 0 2px 0; font-weight: bold; color: #212529;">🔹 Группы тегов:</p>
      <ul style="margin: 0; padding-left: 20px;">
        <li><b>@логин</b> — Логин GitHub (Пример: Фамилия Имя /с @eaststandart)</li>
        <li><b>#techlab-familiya-imya</b> — Тег платформы (Пример: Фамилия Имя /с #techlab-familiya-imya)</li>
      </ul>
    </div>
  </div>
</div>

<!-- Подключение внешнего файла очищенных скриптов JavaScript -->
<script src="{{ '/assets/js/journal-attendance.js' | relative_url }}"></script>
