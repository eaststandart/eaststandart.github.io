{%- comment -%}
@about Модернизированный каноничный модуль генерации и фильтрации общей ленты публикаций на основе feed.yml.
@purpose Автоматический вывод полноценных публикаций для кнопки "0" без тяжелых циклов.
@author TechLab
{%- endcomment -%}

<!--1. HTML-СКЕЛЕТ ВЫВОДА ПОЛНОЦЕННЫХ ПУБЛИКАЦИЙ НА ОСНОВЕ FEED.YML -->

<div id="media-container" class="media-archive-list-wrapper">
  {%- for item in site.data.feed.feed -%}
    {%- comment -%} Подаем нужные данные проекта и категории в цикл фильтрации {%- endcomment -%}
    {%- if item.related == include.project and item.posttype == include.category and item.is_post == "true" -%}
      
      {%- assign post = site.posts | where: "url", item.url | first -%}
      {%- if post == nil -%}
        {%- assign post = site.pages | where: "url", item.url | first -%}
      {%- endif -%}

      {%- if post -%}
        <div class="media-entry" data-project="{{ post.categories | join: ' ' }}" style="display: none;">
          
          <!-- Контейнер строки даты и заголовка -->
          <div class="media-entry-title-row">
            <span class="media-entry-date">{{ post.date | date: "%d.%m.%Y" }}</span>
            <h3 class="media-entry-title">{{ post.title }}</h3>
          </div>
          
          <!-- Оболочка основного контента статьи (1 в 1 как на старом сайте) -->
          <div class="media-content main-content">
            {%- if post.description and post.description != "" -%}
              <p class="page-description">{{ post.description }}</p>
            {%- endif -%}

            {{ post.content }}
           
            {%- if post.author and post.author != "" -%}
            <!-- А. БЛОК ВЫВОДА АВТОРА -->
            <div class="author-inline">
                <strong>Автор:</strong> 
                <div class="sources-content">{{ post.author }}</div>
            </div>
            {%- endif -%}

            {%- if post.sources and post.sources != "" -%}
            <!-- Б. БЛОК ВЫВОДА ИСТОЧНИКОВ -->
            <div class="sources-inline">
                <strong>Источники:</strong>
                <div class="sources-content">{{ post.sources | markdownify }}</div>
            </div>
            {%- endif -%}

            {%- if post.tags.size > 0 -%}
            <!-- В. БЛОК ВЫВОДА ТЕГОВ -->
            <div class="tag-container">
                {%- for tag in post.tags -%}
                    {%- assign tag_clean = tag | replace: '#', '' | strip -%}
                    <a href="{{ '/tags.html' | relative_url }}#{{ tag_clean | slugify }}" class="tag-item">{{ tag_clean }}</a>
                {%- endfor -%}
            </div>
            {%- endif -%}
          </div>
          
          <hr class="media-entry-hr">
        </div>
      {%- endif -%}

    {%- endif -%}
  {%- endfor -%}
</div>

<!-- 2. JAVASCRIPT-ЛОГИКА ФИЛЬТРАЦИИ И ЗАЧИСТКИ (ПОДКЛЮЧЕНИЕ ВНЕШНЕГО JS) -->

<!-- Подключаем оригинальный внешний изолированный файл скрипта раскрытой ленты -->
<script src="{{ '/assets/js/posts-page-list.js' | relative_url }}"></script>

<script>
  // Безопасно запускаем фильтрацию и зачистку линий строго после сборки страницы браузером
  document.addEventListener("DOMContentLoaded", function() {
    if (typeof runMediaArchiveFilter === 'function') {
      runMediaArchiveFilter();
    }
  });
</script>
