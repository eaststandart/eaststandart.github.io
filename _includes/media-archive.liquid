{% comment %} ==========================================================================
   1. HTML-СКЕЛЕТ ВЫВОДА ПОЛНОЦЕННЫХ ПУБЛИКАЦИЙ ИЗ ЦИКЛА JEKYLL
   ========================================================================== {% endcomment %}

{% comment %} 
Автоматически вычисляем имя текущего проекта из адреса самой страницы.
Например, если страница /faire/robot-korova-iz-kartona/, слаг будет "robot-korova-iz-kartona"
{% endcomment %}
{% assign url_parts = page.url | split: "/" %}
{% assign current_project = url_parts[2] | default: url_parts[1] %}

<div id="media-container" class="media-archive-list-wrapper">
  {% for post in site.posts %}
    {% if post.categories contains include.category %}

      {% comment %} 
      ЖЕЛЕЗОБЕТОННЫЙ ФИЛЬТР СБОРКИ: Если медиа-пост не принадлежит текущему проекту, 
      Jekyll полностью пропускает его и НЕ пишет его тяжелый HTML в этот файл.
      {% endcomment %}
      {% unless post.categories contains current_project %}
        {% continue %}
      {% endunless %}

      {% comment %} Пропускаем пост, если задан флаг N {% endcomment %}
      {% if post.media-post-page == "N" or post["media-post-page"] == "N" or post.journal-post-page == "N" or post["journal-post-page"] == "N" %}{% continue %}{% endif %}
    
      {% comment %} Показываем блок сразу (display: block), так как чужого мусора тут больше нет {% endcomment %}
      <div class="media-entry" data-project="{{ post.categories | join: ' ' }}" style="display: block;">
        
        <!-- Контейнер строки даты и заголовка -->
        <div class="media-entry-title-row">
          <span class="media-entry-date">{{ post.date | date: "%d.%m.%Y" }}</span>
          <h3 class="media-entry-title">{{ post.title }}</h3>
        </div>
        
        <!-- Оболочка основного контента статьи -->
        <div class="media-content main-content">
          
          <!-- ДОБАВЛЕНО: Вывод курсивного описания конкретного поста в ленте, если оно заполнено -->
          {% if post.description and post.description != "" %}
            <p class="page-description">{{ post.description }}</p>
          {% endif %}

          {{ post.content }}
          
          {% comment %} ==========================================
             УНИФИКАЦИЯ МЕТАДАННЫХ ПОД ТЕКСТОМ ПОСТА
             ========================================== {% endcomment %}

          <!-- А. БЛОК ВЫВОДА АВТОРА -->
          {% if post.author and post.author != "" %}
          <div class="author-inline">
              <strong>Автор:</strong> 
              <div class="sources-content">
                  {{ post.author }}
              </div>
          </div>
          {% endif %}

          <!-- Б. БЛОК ВЫВОДА ИСТОЧНИКОВ -->
          {% if post.sources and post.sources != "" %}
          <div class="sources-inline">
              <strong>Источники:</strong>
              <div class="sources-content">
                  {{ post.sources | markdownify }}
              </div>
          </div>
          {% endif %}

          <!-- В. БЛОК ВЫВОДА ТЕГОВ -->
          {% if post.tags.size > 0 %}
          <div class="tag-container">
              {% for tag in post.tags %}
                  {% assign tag_clean = tag | replace: '#', '' | strip %}
                  <a href="{{ '/tags.html' | relative_url }}#{{ tag_clean | slugify }}" class="tag-item">{{ tag_clean }}</a>
              {% endfor %}
          </div>
          {% endif %}
        </div>
        
        <hr class="media-entry-hr">
        
      </div>
      
    {% endif %}
  {% endfor %}
</div>

<!-- ==========================================================================
     2. JAVASCRIPT-ЛОГИКА ФИЛЬТРАЦИИ И ЗАЧИСТКИ (ПОДКЛЮЧЕНИЕ ВНЕШНЕГО JS)
     ========================================================================== -->
<!-- Подключаем наш внешний изолированный файл скрипта раскрытой ленты -->
<script src="{{ '/assets/js/posts-page-list.js' | relative_url }}"></script>

<script>
  // Безопасно запускаем фильтрацию и зачистку линий строго после сборки страницы браузером
  document.addEventListener("DOMContentLoaded", function() {
    runMediaArchiveFilter();
  });
</script>
