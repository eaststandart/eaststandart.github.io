{% comment %} 
=============================================================================
ГЛОБАЛЬНЫЙ МОДУЛЬ ОПТИМИЗАЦИИ МЕДИА (media-logic.liquid)
=============================================================================
{% endcomment %}

<!-- Подключаем наше новое ядро парсинга Obsidian -->
<script src="{{ '/assets/js/media-logic-core.js' | relative_url }}"></script>

<!-- Подключаем оригинальные изолированные скрипты ленивой загрузки -->
<script src="{{ '/assets/js/image-lazy-load.js' | relative_url }}"></script>
<script src="{{ '/assets/js/video-lazy-load.js' | relative_url }}"></script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    // ШАГ 1: Мгновенно превращаем текстовые ссылки Obsidian ![[...]] в HTML-теги сеток
    parseObsidianMedia();

    // ШАГ 2: Запускаем оригинальный скрипт ленивой загрузки картинок.
    // Он найдет созданные на Шаге 1 теги img с атрибутом data-src и плавно включит их на экране
    if (typeof runImageLazyLoad === 'function') {
        runImageLazyLoad();
    }

    // ШАГ 3: Запускаем оригинальный видео-скрипт без изменений.
    // Он найдет созданные теги video и возьмет их под контроль ленивого плеера
    if (typeof runVideoLazyLoad === 'function') {
        runVideoLazyLoad();
    }
  });
</script>
