{% comment %} 
=============================================================================
ГЛОБАЛЬНЫЙ МОДУЛЬ ОПТИМИЗАЦИИ МЕДИА (media-logic.liquid)
Назначение: Подключение и последовательный запуск раздельных скриптов ленивой загрузки.
=============================================================================
{% endcomment %}

<!-- 1. Подключаем изолированный внешний файл ленивой загрузки КАРТИНОК -->
<script src="{{ '/assets/js/image-lazy-load.js' | relative_url }}"></script>

<!-- 2. Подключаем изолированный внешний файл ленивой загрузки ВИДЕОПЛЕЕРОВ -->
<script src="{{ '/assets/js/video-lazy-load.js' | relative_url }}"></script>

<script>
  // Запускаем оба движка строго после полной сборки страницы браузером
  document.addEventListener("DOMContentLoaded", function() {
    
    // Активируем ленивое отслеживание картинок (.webp)
    if (typeof runImageLazyLoad === 'function') {
        runImageLazyLoad();
    }

    // Активируем ленивую трансформацию видеоплееров (.webm)
    if (typeof runVideoLazyLoad === 'function') {
        runVideoLazyLoad();
    }
    
  });
</script>
