{%- comment -%}
@about Модуль навигации сайта на чистом Liquid (БЕЗ JAVASCRIPT).
@purpose Вывод хлебных крошек строго на основе метаданных препроцессора Python.
@author TechLab
{%- endcomment -%}

<div class="navigation-header">
    <a href="/" class="back-link nav-header-link nav-blue-link">← Главная</a>
    {%- if page.section and page.section != "" -%}
        {%- if page.post-page == nil or page.post-page == "" -%}
            {%- assign section_url = page.section | prepend: "/" | append: "/" -%}
            {%- assign section_page = site.pages | where: "url", section_url | first -%}
            {%- assign section_text = section_page.navtitle | default: section_page.title | default: page.section -%}
            {%- if page.url != section_url -%}<span class="nav-separator">|</span><a href="{{ section_url | relative_url }}" class="back-link nav-header-link">{{ section_text }}</a>{%- endif -%}
        {%- endif -%}
    {%- endif -%}
    {%- assign target_slug = page.slug -%}
    {%- if target_slug == nil or target_slug == "" -%}
        {%- for cat in page.categories -%}
            {%- if cat != "journal" and cat != "media" and cat != "diary" and cat != "questions" -%}
                {%- assign target_slug = cat -%}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
    {%- if target_slug and target_slug != "" -%}
        {%- if page.section and page.section != "journal" and page.section != "media" and page.section != "questions" -%}
            {%- assign project_url = target_slug | prepend: "/" | prepend: page.section | prepend: "/" | append: "/" -%}
        {%- else -%}
            {%- for section_entry in site.data.navigation.sections -%}
                {%- for project in section_entry -%}
                    {%- if project.slug == target_slug -%}
                        {%- assign project_url = project.url -%}
                        {%- break -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- if project_url -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
        {%- endif -%}
        {%- assign project_page = site.pages | where: "url", project_url | first -%}
        {%- if project_page and page.url != project_page.url -%}
            <span class="nav-separator">|</span><a href="{{ project_page.url | relative_url }}" class="back-link nav-header-link nav-ellipsis-link">{{ project_page.title }}</a>
        {%- endif -%}
    {%- endif -%}<span class="nav-separator">|</span><a href="/tags.html" class="back-link nav-header-link nav-blue-link"># Поиск</a>
</div>
