{%- comment -%}
@about Модуль навигация сайта.
@purpose Вывод хлебных крошек, умных ссылок «Назад» и кнопки тегов на статьях.
@author TechLab
{%- endcomment -%}

<div class="navigation-header">
    <a href="/" class="back-link nav-header-link nav-blue-link">← Главная</a>
    {%- if page.githubpages-section and page.githubpages-section != "" -%}
        {%- if page.githubpages-type == nil or page.githubpages-type == "" -%}
            {%- assign section_url = page.githubpages-section | prepend: "/" | append: "/" -%}
            {%- assign section_page = site.pages | where: "url", section_url | first -%}
            {%- assign section_text = section_page.navtitle | default: section_page.title | default: page.githubpages-section -%}
            {%- if page.url != section_url -%}<span class="nav-separator">|</span><a href="{{ section_url | relative_url }}" class="back-link nav-header-link">{{ section_text }}</a>{%- endif -%}
        {%- endif -%}
    {%- endif -%}
    {%- if page.githubpages-slug and page.githubpages-slug != "" -%}
        {%- if page.githubpages-type and page.githubpages-type != "" -%}
            {%- assign current_project = nil -%}
            {%- for project in site.data.navigation.faire -%}
                {%- if project.url contains page.githubpages-slug -%}
                    {%- assign current_project = project -%}
                    {%- break -%}
                {%- endif -%}
            {%- endfor -%}
            {%- if current_project -%}<span class="nav-separator">|</span><a href="{{ current_project.url | relative_url }}" class="back-link nav-header-link nav-ellipsis-link">{{ current_project.title }}</a>{%- endif -%}
        {%- endif -%}
    {%- endif -%}<span class="nav-separator">|</span><a href="/tags.html" class="back-link nav-header-link nav-blue-link"># Поиск</a>
</div>
