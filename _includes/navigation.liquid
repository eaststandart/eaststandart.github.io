{%- comment -%}
@about Модуль навигации сайта на чистом Liquid (БЕЗ ЦИКЛОВ И JAVASCRIPT).
@purpose Высокоскоростной точечный вывод крошек по каскаду crumbtitle -> title.
@author TechLab
{%- endcomment -%}

<div class="navigation-header">
    <a href="/" class="back-link nav-header-link nav-blue-link">← Главная</a>
    {%- comment -%} Извлекаем паспорт текущей страницы из карты метаданных {%- endcomment -%}
    {%- assign current_passport = site.data.navigation[page.path][0] -%}
    {%- if current_passport -%}
        {%- comment -%} 🧭 КОНТУР РАЗДЕЛОВ И КОЛЛЕКЦИЙ {%- endcomment -%}
        {%- assign root_key = current_passport.relatedsection | default: current_passport.relatedcollection -%}
        {%- if root_key and root_key != "" -%}
            {%- assign root_passport = site.data.navigation[root_key][0] -%}
            {%- if root_passport -%}
                {%- assign root_text = root_passport.crumbtitle | default: root_passport.title -%}
                {%- if root_text and root_text != "" -%}<span class="nav-separator">|</span><a href="{{ root_passport.url | relative_url }}" class="back-link nav-header-link">{{ root_text }}</a>{%- endif -%}
            {%- endif -%}
        {%- endif -%}
        {%- comment -%} 🧭 КОНТУР РОДИТЕЛЬСКИХ ПРОЕКТОВ (Для постов хроники из _posts/) {%- endcomment -%}
        {%- assign parent_path = current_passport.relatedpages -%}
        {%- if parent_path and parent_path != "" -%}
            {%- assign parent_passport = site.data.navigation[parent_path][0] -%}
            {%- if parent_passport -%}
                {%- assign parent_text = parent_passport.crumbtitle | default: parent_passport.title -%}
                {%- if parent_text and parent_text != "" -%}<span class="nav-separator">|</span><a href="{{ parent_passport.url | relative_url }}" class="back-link nav-header-link nav-ellipsis-link">{{ parent_text }}</a>{%- endif -%}
            {%- endif -%}
        {%- endif -%}
    {%- endif -%}<span class="nav-separator">|</span><a href="/tags.html" class="back-link nav-header-link nav-blue-link"># Поиск</a>
</div>
