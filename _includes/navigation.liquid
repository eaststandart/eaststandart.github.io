{%- comment -%}
@about Универсальный модуль навигации ("Хлебные крошки") в шапке сайта.
@purpose Автоматический вывод цепочки ссылок "Назад" для любого раздела сайта на основе чистых свойств.
@author TechLab
{%- endcomment -%}

{%- assign current_section = page.section -%}

<div class="navigation-header">
  <span class="nav-crumb">
    <a href="{{ '/' | relative_url }}" class="nav-link">← Главная</a>
  </span>
  
  {%- if page.slug and page.slug != "" -%}
    {%- comment -%} Если мы находимся на странице открытого дневника (кнопка "0") или странице поста {%- endcomment -%}
    {%- if page.post-page and page.post-page != "" or page.url contains "/journal/" or page.url contains "/media/" -%}
      {%- assign project_found = nil -%}
      {%- for project in site.data.navigation.sections[current_section] -%}
        {%- if project.slug == page.slug -%}
          {%- assign project_found = project -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      
      {%- if project_found -%}
        <span class="nav-separator">|</span>
        <span class="nav-crumb">
          <a href="{{ project_found.url | relative_url }}" class="nav-link nav-ellipsis-link" title="{{ project_found.title }}">
            {{ project_found.title }}
          </a>
        </span>
      {%- endif -%}
    {%- else -%}
      {%- comment -%} Если мы находимся на главной странице самого проекта {%- endcomment -%}
      <span class="nav-separator">|</span>
      <span class="nav-crumb current-crumb">
        <span class="nav-text nav-ellipsis-link" title="{{ page.title }}">{{ page.title }}</span>
      </span>
    {%- endif -%}
  {%- endif -%}
</div>
