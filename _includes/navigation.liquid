{%- comment -%}
@about Модуль навигация сайта.
@purpose Вывод хлебных крошек, умных ссылок «Назад» и кнопки тегов на статьях.
@author TechLab
{%- endcomment -%}

<div class="navigation-header">
    <a href="/" class="back-link nav-header-link nav-blue-link">← Главная</a>
    {%- if page.section and page.section != "" -%}
        {%- if page.post-page == nil or page.post-page == "" -%}
            {%- assign section_url = page.section | prepend: "/" | append: "/" -%}
            {%- assign section_page = site.pages | where: "url", section_url | first -%}
            {%- assign section_text = section_page.navtitle | default: section_page.title | default: page.section -%}
            {%- if page.url != section_url -%}<span class="nav-separator">|</span><a href="{{ section_url | relative_url }}" class="back-link nav-header-link">{{ section_text }}</a>{%- endif -%}
        {%- else -%}
            {%- comment -%} 🔥 НАДЁЖНЫЙ ВЫВОД ДЛЯ ПОСТОВ С ХВОСТИКАМИ ТИПА ИЗ ИМЕНИ ФАЙЛА {%- endcomment -%}
            {%- assign project_slug = "" -%}
            {%- for cat in page.categories -%}
                {%- if cat != "journal" and cat != "media" and cat != "diary" -%}
                    {%- assign project_slug = cat -%}
                {%- endif -%}
            {%- endfor -%}
            {%- if project_slug and project_slug != "" -%}
                {%- assign project_page = site.pages | where_exp: "item", "item.url contains project_slug" | first -%}
                {%- if project_page -%}<span class="nav-separator">|</span><a href="{{ project_page.url | relative_url }}" class="back-link nav-header-link nav-ellipsis-link">{{ project_page.title }}</a>{%- endif -%}
            {%- endif -%}
        {%- endif -%}
    {%- else -%}
        {%- comment -%} 🔥 ДЛЯ СТРАНИЦ НА СТАРЫХ КАТЕГОРИЯХ (БЕЗ ИЗМЕНЕНИЙ ОРИГИНАЛА) {%- endcomment -%}
        {%- if page.categories.size > 0 -%}
            {%- assign project_slug = "" -%}
            {%- for cat in page.categories -%}
                {%- if cat != "journal" and cat != "media" and cat != "diary" -%}
                    {%- assign project_slug = cat -%}
                {%- endif -%}
            {%- endfor -%}
            {%- assign project_page = site.pages | where_exp: "item", "item.url contains project_slug" | first -%}
            {%- if project_page -%}<span class="nav-separator">|</span><a href="{{ project_page.url | relative_url }}" class="back-link nav-header-link nav-ellipsis-link">{{ project_page.title }}</a>{%- endif -%}
        {%- endif -%}
    {%- endif -%}
    {%- if page.slug and page.slug != "" and page.section == nil -%}
        {%- comment -%} 🔥 ОСОБАЯ ПРОВЕРКА ДЛЯ КОЛЛЕКЦИЙ ТИПА _PEOPLE И ДРУГИХ БУДУЩИХ ПАПОК {%- endcomment -%}
        {%- assign url_parts = page.url | split: "/" -%}
        {%- assign folder_name = url_parts[1] -%}
        {%- if folder_name and folder_name != "" and folder_name != page.slug -%}
            {%- assign section_url = folder_name | prepend: "/" | append: "/" -%}
            {%- assign section_page = site.pages | where: "url", section_url | first -%}
            {%- assign section_text = section_page.navtitle | default: section_page.title | default: folder_name -%}
            <span class="nav-separator">|</span><a href="{{ section_url | relative_url }}" class="back-link nav-header-link">{{ section_text }}</a>
        {%- endif -%}
    {%- endif -%}<span class="nav-separator">|</span><a href="/tags.html" class="back-link nav-header-link nav-blue-link"># Поиск</a>
</div>
