{%- comment -%}
@about Сборка и вывод ленты обновлений на чистом Liquid (БЕЗ JAVASCRIPT РОКИРОВОК).
@purpose Выводит готовую отсортированную Питоном ленту из _data/news_feed.yml 1 в 1 в ваших стилях.
@author TechLab 
{%- endcomment -%}

{%- assign news_feed = site.data.news_feed.feed -%}
{%- for item in news_feed -%}
  {%- if include.type == "home" -%}

    <!-- Вариант А: Компактный стиль для Главной страницы (Карточка "Что нового?") -->
    <li class="news-item news-item-compact{% if item.pinned %} pinned-item{% endif %}" 
        data-date="{{ item.date }}" 
        data-is-post="{{ item.is_post }}" 
        data-emoji="{{ item.emoji }}" 
        style="display: none;">
      <div>
        <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
        <span>
          <a href="{{ item.url | relative_url }}" class="item-link">
            {{ item.title }}
          </a>
        </span>
      </div>
    </li>
    
  {%- elsif include.type == "news" -%}
  
    <!-- Вариант Б: Широкий стиль с разделительными линиями для страниц Новостей и Журнала -->
    <li class="news-item{% if item.pinned %} pinned-item{% endif %}" 
        data-date="{{ item.date }}" 
        data-is-post="{{ item.is_post }}" 
        data-emoji="{{ item.emoji }}" 
        style="display: none; margin-bottom: 12px; border-bottom: 1px solid #f0f0f0; padding-bottom: 8px;">
      <div>
        <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
        <span>
          <a href="{{ item.url | relative_url }}" class="item-link" style="text-decoration: none;">
            {{ item.title }}
          </a>
        </span>
      </div>
    </li>
    
  {%- endif -%}
{%- endfor -%}
