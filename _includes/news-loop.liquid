{%- comment -%}
@about Сборка и фильтрация ленты обновлений на основе единой ленты feed.yml.
@purpose Автоматически вычисляет текущий раздел по page.url и фильтрует эмодзи-шум общего контура.
@author TechLab 
{%- endcomment -%}

{%- assign feed_source = site.data.feed.feed -%}

{% comment %} АВТОМАТ АДРЕСОВ: Вырезаем чистое имя текущего раздела из адреса страницы {% endcomment %}
{%- assign current_path_clean = page.url | strip_search | strip_slash -%}
{%- assign url_parts = current_path_clean | split: "/" -%}
{%- assign current_section = url_parts | last | strip | downcase -%}

{%- for item in feed_source -%}
  {%- assign is_allowed = false -%}

  {% comment %} Фильтрация постов для частных лент разделов {% endcomment %}
  {%- if current_section and current_section != "news" -%}
    {%- if item.posttype == current_section -%}
      {%- assign is_allowed = true -%}
    {%- endif -%}
  {%- else -%}
    {% comment %} На Главной странице новостей (news) разрешаем вывод вообще всех постов каскадом {% endcomment %}
    {%- assign is_allowed = true -%}
  {%- endif -%}

  {%- if is_allowed -%}
    {%- comment -%} УМНЫЙ АВТОМАТ ЗАКРЕПОВ: разделяем закрепы для Главной и для частных лент постов {%- endcomment -%}
    {%- assign pinned_class = "" -%}
    {%- if current_section == "news" -%}
      {%- if item.pinned_news == true or item.pinned_news == "true" -%}{%- assign pinned_class = " pinned-item" -%}{%- endif -%}
    {%- else -%}
      {%- if item.pinned_own == true or item.pinned_own == "true" -%}{%- assign pinned_class = " pinned-item" -%}{%- endif -%}
    {%- endif -%}

    {%- if current_section == "news" -%}
      <!-- Вариант А: Компактный стиль для Главной страницы (Карточка "Что нового?") -->
      <li class="news-item news-item-compact{{ pinned_class }}" data-date="{{ item.date }}" data-is-post="{{ item.is_post }}" style="display: none;">
        <div>
          <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
          <span>
            <a href="{{ item.url | relative_url }}" class="item-link">
              {{ item.title }}{% if item.emoji and item.emoji != "" %} {{ item.emoji }}{% endif %}
            </a>
          </span>
        </div>
      </li>
      
    {%- else -%}
      <!-- Вариант Б: Широкий стиль с разделительными линиями для страниц частных лент контура -->
      <li class="news-item{{ pinned_class }}" data-date="{{ item.date }}" data-is-post="{{ item.is_post }}" style="display: none; margin-bottom: 12px; border-bottom: 1px solid #f0f0f0; padding-bottom: 8px;">
        <div>
          <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
          <span>
            <a href="{{ item.url | relative_url }}" class="item-link" style="text-decoration: none;">
              {{ item.title }}{% if item.personal_emoji and item.personal_emoji != "" %} {{ item.personal_emoji }}{% endif %}
            </a>
          </span>
        </div>
      </li>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
