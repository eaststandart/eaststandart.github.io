{%- comment -%}
@about Сборка и вывод ленты обновлений на чистом Liquid (БЕЗ JAVASCRIPT РОКИРОВОК).
@purpose Выводит готовую отсортированную Питоном ленту из _data/news_feed.yml с сохранением стилей.
@author TechLab 
{%- endcomment -%}

{%- assign news_feed = site.data.news_feed.feed -%}

{%- for item in news_feed -%}
  {%- comment -%} 
  Поскольку Питон уже отфильтровал контент по папкам на сервере,
  мы просто выводим элементы один за другим в их родной верстке
  {%- endcomment -%}
  
  {%- if include.type == "home" -%}
  
    <!-- Вариант А: Компактный стиль для Главной страницы (Карточка "Что нового?") -->
    <li class="news-item news-item-compact{% if item.pinned %} pinned-item{% endif %}" 
        data-date="{{ item.date }}" 
        data-is-post="{{ item.is_post }}" 
        data-emoji="{{ item.emoji }}" 
        style="display: none;{% if item.pinned %} background-color: #fffdf0; border-left: 3px solid #ffdb58;{% endif %}">
      <div>
        <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
        <span>
          <a href="{{ item.url | relative_url }}" class="item-link">
            {% if item.pinned %}<strong>[Закреплено]</strong> {% endif %}{{ item.title }}
          </a>
        </span>
      </div>
    </li>
    
  {%- elsif include.type == "news" -%}
  
    <!-- Вариант Б: Широкий стиль с разделительными линиями для страниц Новостей и Журнала -->
    <li class="news-item{% if item.pinned %} pinned-item{% endif %}" 
        data-date="{{ item.date }}" 
        data-is-post="{{ item.is_post }}" 
        data-emoji="{{ item.emoji }}" 
        style="display: none; margin-bottom: 12px; border-bottom: 1px solid #f0f0f0; padding-bottom: 8px;{% if item.pinned %} background-color: #fffdf0; border-left: 3px solid #ffdb58; padding-left: 6px;{% endif %}">
      <div>
        <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
        <span>
          <a href="{{ item.url | relative_url }}" class="item-link" style="text-decoration: none;">
            {% if item.pinned %}<strong>[Закреплено]</strong> {% endif %}{{ item.title }}
          </a>
        </span>
      </div>
    </li>
    
  {%- endif -%}
{%- endfor -%}
