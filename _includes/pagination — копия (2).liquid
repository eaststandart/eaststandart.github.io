{%- comment -%}
@about Модуль пагинации страниц.
@purpose Изолированный запуск постраничного разбиения списков на основе готовой ленты feed.yml.
@author TechLab
{%- endcomment -%}

<div id="{{ include.controls_id }}" class="pagination-controls"></div>

<!-- Подключаем внешний изолированный файл скрипта пагинации -->
<script src="{{ '/assets/js/pagination-logic.js' | relative_url }}"></script>

<script>
  (function() {
    var itemsPerPage = parseInt("{{ include.per_page | default: 10 }}", 10);
    runPagination(
      "{{ include.list_id }}", 
      "{{ include.controls_id }}", 
      itemsPerPage, 
      "{{ include.emoji | default: 'Y' }}"
    );
  })();
</script>
