{%- comment -%}
@about Модуль пагинации страниц.
@purpose Изолированный запуск нативного постраничного разбиения списков.
@author TechLab
{%- endcomment -%}

<div id="{{ include.controls_id }}" class="pagination-controls"></div>

<!-- Подключаем наш внешний изолированный файл скрипта -->
<script src="{{ '/assets/js/pagination-logic.js' | relative_url }}"></script>

<script>
  // Запускаем пагинацию мгновенно на месте без искусственных задержек времени
  (function() {
    var itemsPerPage = parseInt("{{ include.per_page | default: 10 }}", 10);
    runPagination(
      "{{ include.list_id }}", 
      "{{ include.controls_id }}", 
      itemsPerPage, 
      "", 
      "{{ include.emoji | default: 'Y' }}"
    );
  })();
</script>
