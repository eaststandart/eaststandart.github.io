{%- comment -%}
@about Модуль вывода развёрнутой ленты постов (Дневник / Открытая галерея).
@purpose Отображает статьи проекта целиком, с текстом и картинками, для кнопки "0".
@author TechLab
{%- endcomment -%}

{%- assign current_project = nil -%}
{%- for project in site.data.navigation.faire -%}
    {%- if project.url contains page.githubpages-slug -%}
        {%- assign current_project = project -%}
        {%- break -%}
    {%- endif -%}
{%- endfor -%}

{%- assign project_posts = nil -%}
{%- if include.type == "journal" -%}
    {%- assign project_posts = current_project.journal_posts -%}
{%- elsif include.type == "media" -%}
    {%- assign project_posts = current_project.media_posts -%}
{%- endif -%}

{%- if project_posts and project_posts.size > 0 -%}
<ul class="project-list posts-page-list">
  {%- for post_item in project_posts -%}
    {%- assign full_post = site.posts | where: "url", post_item.url | first -%}
    
    {%- if full_post -%}
      <li class="local-post-item posts-page-item" data-date="{{ full_post.date }}">
        <div>
          <span>{{ full_post.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
          <span>
            <a href="{{ full_post.url | relative_url }}" class="item-link posts-page-link">
              {{ full_post.title }}
            </a>
          </span>
        </div>
        
        <!-- Полное развернутое содержимое статьи со всеми картинками и версткой по вашему стандарту -->
        <div class="posts-page-content-body">
          {{ full_post.content }}
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
{%- endif -%}
