{%- comment -%}
@about Монолитный изолированный модуль развернутого вывода постов проекта на основе параметров из Python.
@purpose Чистокровная серверная фильтрация постов по relatedpages и нативное обнуление отступов финального элемента.
@author TechLab
{%- endcomment -%}

{%- assign target_file = include.project_file -%}
{%- assign target_category = include.category -%}

<!--1. HTML-СКЕЛЕТ ВЫВОДА ПОЛНОЦЕННЫХ ПУБЛИКАЦИЙ ПРОЕКТА ИЗ FEED.YML -->
<div id="media-container" class="media-archive-list-wrapper">
  {%- comment -%} Отбираем только валидные посты из глобального фида, подходящие под нужную категорию ленты {%- endcomment -%}
  {%- assign current_feed = site.data.feed.feed | where: "posttype", target_category | where: "is_post", "true" -%}
  
  {%- for feed_item in current_feed -%}
    {%- assign post = site.posts | where: "url", feed_item.url | first -%}
    {%- if post == nil -%}
      {%- assign post = site.pages | where: "url", feed_item.url | first -%}
    {%- endif -%}
    
    {%- if post -%}
      {%- comment -%} 🎯 ТОЧНЫЙ СЕРВЕРНЫЙ ФИЛЬТР СВЯЗЕЙ: Находим паспорт поста в навигационном дереве и сверяем relatedpages {%- endcomment -%}
      {%- assign post_nav = site.data.navigation[feed_item.url] -%}
      {%- if post_nav == nil -%}
        {%- comment -%} Если ключ в навигации записан как путь к md-файлу, делаем сквозной поиск по URL {%- endcomment -%}
        {%- for nav_node in site.data.navigation -%}
          {%- assign node_list = nav_node[1] -%}
          {%- if node_list[0].url == feed_item.url -%}
            {%- assign post_nav = node_list[0] -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign post_nav = post_nav[0] -%}
      {%- endif -%}

      {%- if post_nav.relatedpages == target_file -%}
        
        {%- comment -%} ЖЕСТКИЙ ПРЕДОХРАНИТЕЛЬ: Проверяем ваши оригинальные флаги со значением N и отсекаем лишние страницы {%- endcomment -%}
        {%- if target_category == "journal" -%}
          {%- if post.journal-post-page == "N" or post["journal-post-page"] == "N" -%}{%- continue -%}{%- endif -%}
        {%- endif -%}
        {%- if target_category == "media" -%}
          {%- if post.media-post-page == "N" or post["media-post-page"] == "N" -%}{%- continue -%}{%- endif -%}
        {%- endif -%}
        
        <div class="media-entry"{% if forloop.last %} style="margin-bottom: 0px !important;"{% endif %}>
          <!-- Контейнер строки даты и заголовка -->
          <div class="media-entry-title-row">
            <span class="media-entry-date">{{ post.date | date: "%d.%m.%Y" }}</span>
            <h3 class="media-entry-title">{{ post.title }}</h3>
          </div>
          
          <!-- Оболочка основного контента статьи (1 в 1 как на старом сайте) -->
          <div class="media-content main-content">
            {%- if post.description and post.description != "" -%}
              <p class="page-description">{{ post.description }}</p>
            {%- endif -%}
            
            {{ post.content }}
            
            {%- if post.author and post.author != "" -%}
            <!-- А. БЛОК ВЫВОДА АВТОРА -->
            <div class="author-inline">
                <strong>Автор:</strong> 
                <div class="sources-content">{{ post.author }}</div>
            </div>
            {%- endif -%}
            
            {%- if post.sources and post.sources != "" -%}
            <!-- Б. БЛОК ВЫВОДА ИСТОЧНИКОВ -->
            <div class="sources-inline">
                <strong>Источники:</strong>
                <div class="sources-content">{{ post.sources | markdownify }}</div>
            </div>
            {%- endif -%}
            
            {%- if post.tags.size > 0 -%}
            <!-- В. БЛОК ВЫВОДА ТЕГОВ -->
            <div class="tag-container">
                {%- for tag in post.tags -%}
                    {%- assign tag_clean = tag | replace: "#", "" | strip -%}
                    <a href="{{ '/tags.html' | relative_url }}#{{ tag_clean | slugify }}" class="tag-item">{{ tag_clean }}</a>
                {%- endfor -%}
            </div>
            {%- endif -%}
          </div>
          
          {%- unless forloop.last -%}
            <hr class="media-entry-hr">
          {%- endunless -%}
        </div>

      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</div>
