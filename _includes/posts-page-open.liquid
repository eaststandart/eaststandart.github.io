{%- comment -%}
@about Генерация развёрнутой ленты постов проекта.
@purpose Автоматический вывод полноценных публикаций для кнопки "0" на основе данных Python.
@author TechLab
{%- endcomment -%}

<div id="media-container" class="media-archive-list-wrapper">
{%- assign current_section = page.section -%}
{%- assign current_project = nil -%}
{%- for project in site.data.navigation.sections[current_section] -%}
  {%- if project.slug == page.slug -%}
      {%- assign current_project = project -%}
      {%- break -%}
  {%- endif -%}
{%- endfor -%}

  {%- assign project_posts = nil -%}
  {%- if include.type == "journal" -%}
    {%- assign project_posts = current_project.journal_posts -%}
  {%- elsif include.type == "media" -%}
    {%- assign project_posts = current_project.media_posts -%}
  {%- endif -%}

  {%- if project_posts and project_posts.size > 0 -%}
    {%- for post_item in project_posts -%}
      {%- assign post = site.posts | where: "url", post_item.url | first -%}
      
      {%- if post -%}
        {%- if post.media-post-page == "N" or post["media-post-page"] == "N" or post.journal-post-page == "N" or post["journal-post-page"] == "N" -%}{%- continue -%}{%- endif -%}
        
        <div class="media-entry">
          
          <!-- Контейнер строки даты и заголовка -->
          <div class="media-entry-title-row">
            <span class="media-entry-date">{{ post.date | date: "%d.%m.%Y" }}</span>
            <h3 class="media-entry-title">{{ post.title }}</h3>
          </div>
          
          <!-- Оболочка основного контента статьи -->
          <div class="media-content main-content">
            {%- if post.description and post.description != "" -%}
              <p class="page-description">{{ post.description }}</p>
            {%- endif -%}

            {{ post.content }}
           
            {%- if post.author and post.author != "" -%}
            <!-- А. БЛОК ВЫВОДА АВТОРА -->
            <div class="author-inline">
                <strong>Автор:</strong> 
                <div class="sources-content">{{ post.author }}</div>
            </div>
            {%- endif -%}

            {%- if post.sources and post.sources != "" -%}
            <!-- Б. БЛОК ВЫВОДА ИСТОЧНИКОВ -->
            <div class="sources-inline">
                <strong>Источники:</strong>
                <div class="sources-content">{{ post.sources | markdownify }}</div>
            </div>
            {%- endif -%}

            {%- if post.tags.size > 0 -%}
            <!-- В. БЛОК ВЫВОДА ТЕГОВ -->
            <div class="tag-container">
                {%- for tag in post.tags -%}
                    {%- assign tag_clean = tag | replace: '#', '' | strip -%}
                    <a href="{{ '/tags.html' | relative_url }}#{{ tag_clean | slugify }}" class="tag-item">{{ tag_clean }}</a>
                {%- endfor -%}
            </div>
            {%- endif -%}
          </div>
          
          {%- comment -%} Линию hr рисуем только если это не последний пост в массиве {%- endcomment -%}
          {%- unless forloop.last -%}
            <hr class="media-entry-hr">
          {%- endunless -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>
