{%- comment -%}
@about Сборка развёрнутой ленты постов проекта под плоскую карту.
@purpose Автоматический вывод полноценных публикаций для кнопки "0".
@author TechLab
{%- endcomment -%}

<div id="media-container" class="media-archive-list-wrapper">
  {%- assign target_project_slug = page.project -%}
  {%- assign target_posttype = page.posttype | default: include.type -%}
  
  {%- for post in site.posts -%}
    {%- assign post_passport = site.data.navigation[post.relative_path] | first -%}
    {%- if post_passport and post_passport.posttype == target_posttype -%}
      {%- assign rel_parts = post_passport.relatedpages | split: "/" -%}
      {%- assign rel_slug = rel_parts | last -%}
      {%- if rel_slug == target_project_slug -%}
        
        {%- if post.media-post-page == "N" or post["media-post-page"] == "N" or post.journal-post-page == "N" or post["journal-post-page"] == "N" -%}
          {%- continue -%}
        {%- endif -%}
        
        <div class="media-entry">
          <!-- Контейнер строки даты и заголовка -->
          <div class="media-entry-title-row">
            <span class="media-entry-date">{{ post_passport.date | date: "%d.%m.%Y" }}</span>
            <h3 class="media-entry-title">{{ post.title }}</h3>
          </div>
          
          <!-- Оболочка основного контента статьи -->
          <div class="media-content main-content">
            {%- if post.description and post.description != "" -%}
              <p class="page-description">{{ post.description }}</p>
            {%- endif -%}

            {{ post.content }}
           
            {%- if post.author and post.author != "" -%}
            <!-- А. БЛОК ВЫВОДА АВТОРА -->
            <div class="author-inline">
                <strong>Автор:</strong> 
                <div class="sources-content">{{ post.author }}</div>
            </div>
            {%- endif -%}

            {%- if post.sources and post.sources != "" -%}
            <!-- Б. БЛОК ВЫВОДА ИСТОЧНИКОВ -->
            <div class="sources-inline">
                <strong>Источники:</strong>
                <div class="sources-content">{{ post.sources | markdownify }}</div>
            </div>
            {%- endif -%}

            {%- if post.tags.size > 0 -%}
            <!-- В. БЛОК ВЫВОДА ТЕГОВ -->
            <div class="tag-container">
                {%- for tag in post.tags -%}
                    {%- assign tag_clean = tag | replace: '#', '' | strip -%}
                    <a href="{{ '/tags.html' | relative_url }}#{{ tag_clean | slugify }}" class="tag-item">{{ tag_clean }}</a>
                {%- endfor -%}
            </div>
            {%- endif -%}
          </div>
          
          {%- unless forloop.last -%}
            <hr class="media-entry-hr">
          {%- endunless -%}
        </div>
        
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</div>
