{%- comment -%}
@about Локальные ленты постов на страницах проектов.
@purpose Вывод списков журнал, media внутри карточек конкретных проектов на основе нативного дерева.
@author TechLab
{%- endcomment -%}

{%- comment -%} 1. ОПРЕДЕЛЯЕМ СЛАГ ПРОЕКТА ИЗ URL ИЛИ СВОЙСТВ ТЕКУЩЕЙ СТРАНИЦЫ {%- endcomment -%}
{%- assign project_slug = page.githubpages-slug | default: page.categories[1] -%}

{%- comment -%} 2. НАХОДИМ НАШ ПРОЕКТ В СГЕНЕРИРОВАННОЙ КАРТЕ PYTHON {%- endcomment -%}
{%- assign current_project = nil -%}
{%- for project in site.data.navigation.faire -%}
    {%- if project.url contains project_slug -%}
        {%- assign current_project = project -%}
        {%- break -%}
    {%- endif -%}
{%- endfor -%}

{%- comment -%} 3. ОПРЕДЕЛЯЕМ ЦЕЛЕВОЙ МАССИВ В ЗАВИСИМОСТИ ОТ ТИПА ИНКЛУДА {%- endcomment -%}
{%- assign project_posts = nil -%}
{%- if include.type == "journal" -%}
    {%- assign project_posts = current_project.journal_posts -%}
{%- elsif include.type == "media" -%}
    {%- assign project_posts = current_project.media_posts -%}
{%- endif -%}

{%- comment -%} 4. ГЕНЕРИРУЕМ УНИКАЛЬНЫЙ ID ДЛЯ КОНТЕЙНЕРА СПИСКА {%- endcomment -%}
{%- assign loop_id = include.type | append: "-list-" | append: project_slug -%}

{%- comment -%} 5. ВЫВОД СТАТИЧЕСКОГО СПИСКА В ВАШЕМ ОРИГИНАЛЬНОМ ДИЗАЙНЕ {%- endcomment -%}
{%- if project_posts and project_posts.size > 0 -%}
<ul id="{{ loop_id }}" class="project-list posts-page-list list-style-none">
  {%- for post in project_posts -%}
    {%- assign is_post = true -%}{%- if include.type == "media" -%}{%- assign is_post = false -%}{%- endif -%}
    <li class="local-post-item posts-page-item" data-date="{{ post.date }}" data-is-post="{{ is_post }}" data-emoji=""><div><span>{{ post.date | date: "%d.%m.%Y" }} &raquo; </span><span><a href="{{ post.url | relative_url }}" class="item-link posts-page-link">{{ post.title }}</a></span></div></li>
  {%- endfor -%}
</ul>
{%- endif -%}
