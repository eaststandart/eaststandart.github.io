{%- comment -%}
@about Локальные ленты постов на страницах проектов. Спасённая рабочая версия.
@purpose Вывод списков журнал, media внутри карточек конкретных проектов.
@author TechLab
{%- endcomment -%}

{% assign url_parts = page.url | split: "/" %}
{% assign project_slug_last = url_parts[2] %}

{% assign has_posts = false %}
{% for post in site.categories[project_slug_last] %}
  {% if post.categories contains include.type %}
    {% assign has_posts = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% if has_posts %}
{% assign loop_id = include.type | append: "-test-" | append: project_slug_last %}
{% assign ctrl_id = "ctrl-" | append: loop_id %}
{% assign archive_url = "/" | append: include.type | append: "/" %}

<ul id="{{ loop_id }}" class="project-list posts-page-list">
  {%- for post in site.categories[project_slug_last] -%}
    {%- if post.categories contains include.type -%}
      {%- assign is_post = true -%}
      {%- if include.type == "media" -%}{%- assign is_post = false -%}{%- endif -%}
      
      <!-- Проверяем сквозную дату из плоской карты Питона для вывода строк -->
      {%- assign post_passport = site.data.navigation[post.relative_path] | first -%}
      {%- assign display_date = post_passport.date | default: post.date | date: "%Y-%m-%d" -%}

      <li class="local-post-item posts-page-item" data-date="{{ display_date }}" data-is-post="{{ is_post }}" data-emoji="">
        <div>
          <span>{{ display_date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
          <span>
            <!-- Используем канонический post.url вашего старого рабочего сайта! -->
            <a href="{{ post.url | relative_url }}" class="item-link posts-page-link">
              {{ post.title }}
            </a>
          </span>
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

<div id="{{ ctrl_id }}" class="posts-page-ctrl" style=""></div>

<script src="{{ '/assets/js/posts-page-nav.js' | relative_url }}"></script>
<script>
  (function() {
    runPostsPageNav(
      "{{ loop_id }}", 
      "{{ ctrl_id }}", 
      "{{ include.per_page }}", 
      "{{ archive_url }}", 
      "{{ include.type }}", 
      "{{ project_slug_last }}"
    );
  })();
</script>
{% endif %}
