{%- comment -%}
@about Универсальные локальные ленты постов на страницах проектов.
@purpose Автоматический вывод списков "Журнал" и "Галерея" для любого раздела сайта.
@author TechLab
{%- endcomment -%}

{%- assign current_section = page.section -%}

{%- comment -%} 2. НАХОДИМ ТЕКУЩИЙ ПРОЕКТ В СГЕНЕРИРОВАННОЙ КАРТЕ PYTHON ПО СЛАГУ {%- endcomment -%}
{%- assign current_project = nil -%}
{%- for project in site.data.navigation.sections[current_section] -%}
    {%- if project.slug == page.slug -%}
        {%- assign current_project = project -%}
        {%- break -%}
    {%- endif -%}
{%- endfor -%}

{%- comment -%} 3. ОПРЕДЕЛЯЕМ ЦЕЛЕВОЙ МАССИВ В ЗАВИСИМОСТИ ОТ ТИПА ИНКЛУДА {%- endcomment -%}
{%- assign project_posts = nil -%}
{%- if include.type == "journal" -%}
    {%- assign project_posts = current_project.journal_posts -%}
{%- elsif include.type == "media" -%}
    {%- assign project_posts = current_project.media_posts -%}
{%- endif -%}

{%- comment -%} 4. ГЕНЕРИРУЕМ УНИКАЛЬНЫЙ ID ДЛЯ КОНТЕЙНЕРА СПИСКА {%- endcomment -%}
{%- assign loop_id = include.type | append: "-list-" | append: page.slug -%}

<!-- 1. HTML-РАЗМЕТКА СПИСКА СТРОК В ВАШЕМ ОРИГИНАЛЬНОМ ДИЗАЙНЕ БЕЗ ИЗМЕНЕНИЙ -->
{%- if project_posts and project_posts.size > 0 -%}
<ul id="{{ loop_id }}" class="project-list posts-page-list">
  {%- for post in project_posts -%}
    {%- assign is_post = true -%}
    {%- if include.type == "media" -%}{%- assign is_post = false -%}{%- endif -%}
    <li class="local-post-item posts-page-item" data-date="{{ post.date }}" data-is-post="{{ is_post }}" data-emoji="">
      <div>
        <span>{{ post.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
        <span>
          <a href="{{ post.url | relative_url }}" class="item-link posts-page-link">
            {{ post.title }}
          </a>
        </span>
      </div>
    </li>
  {%- endfor -%}
</ul>
{%- endif -%}

{%- comment -%} Генерируем уникальный ID для блока кнопок управления {%- endcomment -%}
{%- assign ctrl_id = "ctrl-" | append: loop_id -%}

<!-- Блок кнопок управления локальной пагинацией -->
<div id="{{ ctrl_id }}" class="posts-page-ctrl"></div>

<!-- Подключаем наш адаптированный внешний скрипт -->
<script src="{{ '/assets/js/posts-page-nav.js' | relative_url }}"></script>

<script>
  (function() {
    // Запускаем пагинатор строго по вашим оригинальным правилам и классам
    runPostsPageNav(
      "{{ loop_id }}", 
      "{{ ctrl_id }}", 
      "{{ include.per_page }}", 
      "/{{ include.type }}/", 
      "{{ include.type }}", 
      "{{ page.slug }}"
    );
  })();
</script>
