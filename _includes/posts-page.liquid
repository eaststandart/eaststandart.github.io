{%- comment -%}
@about Локальные ленты постов на страницах проектов из единого источника feed.yml.
@purpose Вывод списков журнал, медиа внутри карточек конкретных проектов без привязки к категориям Jekyll.
@author TechLab
{%- endcomment -%}

{% comment %} Разбираем URL страницы на части для вычисления разделов и слагов проекта {% endcomment %}
{% assign url_parts = page.url | split: "/" %}
{% assign section_slug = url_parts[1] %}
{% assign project_slug = url_parts[2] %}
{% assign section_url = section_slug | prepend: "/" | append: "/" %}
{% assign section_page = site.pages | where: "url", section_url | first %}

{% assign project_slug_last = page.url | split: "/" | last %}
{% assign feed_source = site.data.feed.feed %}

{% comment %} Счётчик-предохранитель: проверяем, есть ли публикации для этого проекта в feed.yml {% endcomment %}
{% assign has_posts = false %}
{% for item in feed_source %}
  {% if item.related == project_slug_last and item.posttype == include.type %}
    {% assign has_posts = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% if has_posts %}
{% comment %} Генерируем уникальные ID для контейнеров списка и кнопок под этот цикл {% endcomment %}
{% assign loop_id = include.type | append: "-test-" | append: project_slug_last %}
{% assign ctrl_id = "ctrl-" | append: loop_id %}

{% comment %} Автоматически вычисляем и собираем адрес перехода в большой архив проекта {% endcomment %}
{% assign archive_url = "/" | append: include.type | append: "/?project=" | append: project_slug | append: "&nav=" | append: section_slug | append: "&title=" | append: section_page.navtitle | default: section_slug %}

<!-- 1. HTML-РАЗМЕТКА СПИСКА СТРОК И КОНТЕЙНЕРА ПАГИНАЦИИ -->

<ul id="{{ loop_id }}" class="project-list posts-page-list">
  {%- for item in feed_source -%}
    {%- if item.related == project_slug_last and item.posttype == include.type -%}
      <li class="local-post-item posts-page-item" data-date="{{ item.date }}" data-is-post="{{ item.is_post }}" data-emoji="{{ item.emoji }}">
        <div>
          <span>{{ item.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
          <span>
            <a href="{{ item.url | relative_url }}" class="item-link posts-page-link">
              {{ item.title }}
            </a>
          </span>
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

<!-- Изолированный блок кнопок управления локальной пагинацией -->
<div id="{{ ctrl_id }}" class="posts-page-ctrl" style=""></div>

<!-- 2. JAVASCRIPT-ЛОГИКА КЛИЕНТСКОЙ ПАГИНАЦИИ ДЛЯ ПРОЕКТОВ (ВНЕШНИЙ СКРИПТ) -->

<!-- Подключаем наш внешний изолированный файл скрипта локальной пагинации -->
<script src="{{ '/assets/js/posts-page-nav.js' | relative_url }}"></script>

<script>
  (function() {
    // Безопасно экранируем текстовые переменные через Liquid, защищая сборщик от сбоев кавычек
    var navTitleClean = decodeURIComponent("{{ section_page.navtitle | default: section_slug | cgi_escape }}");

    // Запускаем пагинатор на месте с его родными изолированными параметрами
    runPostsPageNav(
      "{{ loop_id }}", 
      "{{ ctrl_id }}", 
      "{{ include.per_page }}", 
      "{{ archive_url }}", 
      "{{ include.type }}", 
      "{{ project_slug_last }}", 
      "{{ section_slug }}", 
      navTitleClean
    );
  })();
</script>
{% endif %}
