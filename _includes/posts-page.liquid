{% comment %} 
=============================================================================
МОДУЛЬ: ЛОКАЛЬНЫЕ ЛЕНТЫ ПОСТОВ НА СТРАНИЦАХ ПРОЕКТОВ (posts-page.liquid)
=============================================================================
{% endcomment %}

{% assign url_parts = page.url | split: "/" %}
{% assign section_slug = url_parts[1] %}
{% assign project_slug = url_parts[2] %}
{% assign section_url = section_slug | prepend: "/" | append: "/" %}
{% assign section_page = site.pages | where: "url", section_url | first %}

{% assign project_slug_last = page.url | split: "/" | last %}

{% comment %} Счётчик-предохранитель с учетом флага фильтрации media-post-page {% endcomment %}
{% assign has_posts = false %}
{% for post in site.categories[project_slug_last] %}
  {% if post.categories contains include.type %}
    {% comment %} Если это тип медиа и стоит флаг N — пропускаем пост {% endcomment %}
    {% if include.type == "media" and post.media-post-page == "N" %}{% continue %}{% endif %}
    
    {% assign has_posts = true %}
    {% break %}
  {% endif %}
{% endfor %}

{% if has_posts %}
{% assign loop_id = include.type | append: "-test-" | append: project_slug_last %}
{% assign ctrl_id = "ctrl-" | append: loop_id %}
{% assign archive_url = "/" | append: include.type | append: "/?project=" | append: project_slug | append: "&nav=" | append: section_slug | append: "&title=" | append: section_page.navtitle | default: section_slug %}

<!-- ==========================================================================
     1. HTML-РАЗМЕТКА СПИСКА СТРОК И КОНТЕЙНЕРА ПАГИНАЦИИ
     ========================================================================== -->

<ul id="{{ loop_id }}" class="project-list posts-page-list">
  {% for post in site.categories[project_slug_last] %}
    {% if post.categories contains include.type %}
      {% comment %} Главная проверка фильтрации: если это медиа и флаг равен N, пост не рендерится {% endcomment %}
      {% if include.type == "media" and post.media_post_page == "N" %}{% continue %}{% endif %}

      {% assign is_post = true %}
      {% if include.type == "media" %}{% assign is_post = false %}{% endif %}

      <li class="local-post-item posts-page-item" data-date="{{ post.date | date: '%Y-%m-%d' }}" data-is-post="{{ is_post }}" data-emoji="">
        <div>
          <span>{{ post.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
          <span>
            <a href="{{ post.url | relative_url }}" class="item-link posts-page-link">
              {{ post.title }}
            </a>
          </span>
        </div>
      </li>
    {% endif %}
  {% endfor %}
</ul>

<!-- Изолированный блок кнопок управления локальной пагинацией -->
<div id="{{ ctrl_id }}" class="posts-page-ctrl" style=""></div>

<!-- ==========================================================================
     2. JAVASCRIPT-ЛОГИКА КЛИЕНТСКОЙ ПАГИНАЦИИ ДЛЯ ПРОЕКТОВ (ВНЕШНИЙ СКРИПТ)
     ========================================================================== -->
<script src="{{ '/assets/js/posts-page-nav.js' | relative_url }}"></script>

<script>
  (function() {
    var navTitleClean = decodeURIComponent("{{ section_page.navtitle | default: section_slug | cgi_escape }}");

    runPostsPageNav(
      "{{ loop_id }}", 
      "{{ ctrl_id }}", 
      "{{ include.per_page }}", 
      "{{ archive_url }}", 
      "{{ include.type }}", 
      "{{ project_slug_last }}", 
      "{{ section_slug }}", 
      navTitleClean
    );
  })();
</script>
{% endif %}
