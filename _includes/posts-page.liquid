{%- comment -%}
@about Локальные ленты постов на страницах проектов.
@purpose Вывод списков журнал, media внутри карточек конкретных проектов на основе нативного дерева.
@author TechLab
{%- endcomment -%}

{%- assign current_project = nil -%}
{%- for project in site.data.navigation.faire -%}
    {%- if project.url contains page.githubpages-slug -%}
        {%- assign current_project = project -%}
        {%- break -%}
    {%- endif -%}
{%- endfor -%}

{%- assign project_posts = nil -%}
{%- if include.type == "journal" -%}
    {%- assign project_posts = current_project.journal_posts -%}
{%- elsif include.type == "media" -%}
    {%- assign project_posts = current_project.media_posts -%}
{%- endif -%}

{%- assign loop_id = include.type | append: "-list-" | append: page.githubpages-slug -%}

{%- if project_posts and project_posts.size > 0 -%}
  {%- comment -%} Исправляем баг пустой строки: если per_page пустой, выводим все посты {%- endcomment -%}
  {%- assign posts_limit = include.per_page -%}
  {%- if posts_limit == nil or posts_limit == "" or posts_limit == 0 -%}
    {%- assign posts_limit = project_posts.size -%}
  {%- endif -%}

  <ul id="{{ loop_id }}" class="project-list posts-page-list">
    {%- for post in project_posts limit: posts_limit -%}
      {%- assign is_post = true -%}
      {%- if include.type == "media" -%}{%- assign is_post = false -%}{%- endif -%}

      <li class="local-post-item posts-page-item" data-date="{{ post.date }}" data-is-post="{{ is_post }}" data-emoji="">
        <div>
          <span>{{ post.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
          <span>
            <a href="{{ post.url | relative_url }}" class="item-link posts-page-link">{{ post.title }}</a>
          </span>
        </div>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

<div class="posts-page-ctrl">
  <a href="/{{ include.type }}/" class="posts-page-btn posts-page-all-btn"> » </a>
  <a href="/{{ include.type }}/{{ page.githubpages-slug }}/" class="posts-page-btn"> 0 </a>
</div>

