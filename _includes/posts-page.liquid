{%- comment -%}
@about Локальные ленты постов на страницах проектов под плоскую карту.
@purpose Вывод списков журнал, media внутри карточек конкретных проектов.
@author TechLab
{%- endcomment -%}

{%- assign current_project_path = page.path -%}
{%- assign loop_id = include.type | append: "-test-" | append: page.slug -%}
{%- assign ctrl_id = "ctrl-" | append: loop_id -%}
{%- assign archive_url = "/" | append: include.type | append: "/" -%}

<!-- 1. HTML-РАЗМЕТКА СПИСКА СТРОК И КОНТЕЙНЕРА ПАГИНАЦИИ -->
<ul id="{{ loop_id }}" class="project-list posts-page-list">
  {%- for post in site.posts -%}
    {%- assign post_passport = site.data.navigation[post.relative_path] | first -%}
    {%- if post_passport -%}
      {%- if post_passport.relatedpages == current_project_path and post_passport.posttype == include.type -%}
        {%- assign is_post = true -%}
        {%- if include.type == "media" -%}{%- assign is_post = false -%}{%- endif -%}
        <li class="local-post-item posts-page-item" data-date="{{ post_passport.date }}" data-is-post="{{ is_post }}" data-emoji="">
          <div>
            <span>{{ post_passport.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
            <span>
              <a href="{{ post_passport.url | relative_url }}" class="item-link posts-page-link">
                {{ post.title }}
              </a>
            </span>
          </div>
        </li>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</ul>

<!-- Изолированный блок кнопок управления локальной пагинацией -->
<div id="{{ ctrl_id }}" class="posts-page-ctrl" style=""></div>

<!-- 2. JAVASCRIPT-ЛОГИКА КЛИЕНТСКОЙ ПАГИНАЦИИ ДЛЯ ПРОЕКТОВ (ВНЕШНИЙ СКРИПТ) -->
<script src="{{ '/assets/js/posts-page-nav.js' | relative_url }}"></script>

<script>
  (function() {
    runPostsPageNav(
      "{{ loop_id }}", 
      "{{ ctrl_id }}", 
      "{{ include.per_page | default: 5 }}", 
      "{{ archive_url }}", 
      "{{ include.type }}", 
      "{{ page.slug }}"
    );
  })();
</script>
