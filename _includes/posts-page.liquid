{{%- comment -%}}
@about Шаблон вкладок ("Журнал" и "Галерея работы") внутри главной страницы проекта.
@purpose Автоматический вывод связанных постов с JS-пагинацией по 5 штук.
@author TechLab
{{%- endcomment -%}}

{{%- assign current_section = page.section -%}}
{{%- assign current_project = nil -%}}

{{%- comment -%}} Находим текущий проект в карте sections по его слагу {{%- endcomment -%}}
{{%- for project in site.data.navigation.sections[current_section] -%}}
  {{%- if project.url == page.permalink -%}}
    {{%- assign current_project = project -%}}
    {{%- break -%}}
  {{%- endif -%}}
{{%- endfor -%}}

{{%- assign post_type = include.type | append: "_posts" -%}}
{{%- assign posts_list = current_project[post_type] -%}}
{{%- assign per_page = include.per_page | default: 5 | plus: 0 -%}}

<div id="{{ include.type }}-container" class="posts-archive-list-wrapper" data-per-page="{{ per_page }}">
  {{%- if posts_list and posts_list.size > 0 -%}}
    <ul class="posts-vector-list" style="list-style-type: none; padding-left: 0;">
      {{%- for post in posts_list -%}}
        <li class="post-vector-item" style="display: none; margin-bottom: 8px;">
          <span class="post-vector-date" style="color: #555; margin-right: 10px; font-family: monospace;">
            {{ post.date | date: "%Y.%m.%d" }}
          </span>
          <a href="{{ post.url | relative_url }}" class="post-vector-link" style="text-decoration: none;">
            » {{ post.title }}
          </a>
        </li>
      {{%- endfor -%}}
    </ul>
    
    <div class="posts-pagination-controls" style="margin-top: 15px; display: flex; align-items: center; gap: 10px;">
      <button class="posts-page-prev" style="padding: 4px 8px; cursor: pointer;" disabled>« Новее</button>
      <span class="posts-page-indicator" style="font-size: 14px; font-family: monospace;">Страница 1 из 1</span>
      <button class="posts-page-next" style="padding: 4px 8px; cursor: pointer;">Старее »</button>
      <button class="posts-page-all-open" onclick="location.href='{{ '/' | relative_url }}{{ include.type }}/{{ page.slug }}/'" style="padding: 4px 8px; cursor: pointer; margin-left: auto; color: #0056b3; font-weight: bold;">0</button>
    </div>
  {{%- else -%}}
    <p class="posts-empty-message" style="color: #666; font-style: italic;">Записей пока нет.</p>
  {{%- endif -%}}
</div>
