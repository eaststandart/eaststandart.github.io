{%- comment -%}
@about Локальные ленты постов на страницах проектов.
@purpose Вывод списков журнал, медиа внутри карточек конкретных проектов на основе нативной логики категорий.
@author TechLab
{%- endcomment -%}

{% assign url_parts = page.url | split: "/" %}
{% assign section_slug = url_parts[1] %}
{% assign real_project_slug = url_parts[2] %}

{% comment %} Обманываем жесткий JS: передаем в параметр слага сразу комбинацию раздел/проект {% endcomment %}
{% assign project_slug_last = section_slug | append: "/" | append: real_project_slug %}

{% assign loop_id = include.type | append: "-test-" | append: real_project_slug %}
{% assign ctrl_id = "ctrl-" | append: loop_id %}

{% comment %} «Ёлочки» (») универсально ведут на корень всего журнала или медиа {% endcomment %}
{% assign archive_url = "/" | append: include.type | append: "/" %}

<!-- 1. HTML-РАЗМЕТКА СПИСКА СТРОК И КОНТЕЙНЕРА ПАГИНАЦИИ -->

<!-- Список строк публикаций с новыми говорящими двойными именами классов -->
<ul id="{{ loop_id }}" class="project-list posts-page-list">
  {%- for post in site.categories[project_slug_last] -%}
    {%- if post.categories contains include.type -%}
      {%- assign is_post = true -%}
      {%- if include.type == "media" -%}{%- assign is_post = false -%}{%- endif -%}
      <li class="local-post-item posts-page-item" data-date="{{ post.date | date: '%Y-%m-%d' }}" data-is-post="{{ is_post }}" data-emoji="">
        <div>
          <span>{{ post.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
          <span>
            <a href="{{ post.url | relative_url }}" class="item-link posts-page-link">
              {{ post.title }}
            </a>
          </span>
        </div>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

<!-- Изолированный блок кнопок управления локальной пагинацией -->
<div id="{{ ctrl_id }}" class="posts-page-ctrl" style=""></div>

<!-- 2. JAVASCRIPT-ЛОГИКА КЛИЕНТСКОЙ ПАГИНАЦИИ ДЛЯ ПРОЕКТОВ (ВНЕШНИЙ СКРИПТ) -->

<!-- Подключаем наш внешний изолированный файл скрипта локальной пагинации -->
<script src="{{ '/assets/js/posts-page-nav.js' | relative_url }}"></script>

<script>
  (function() {
    runPostsPageNav(
      "{{ loop_id }}", 
      "{{ ctrl_id }}", 
      "{{ include.per_page }}", 
      "{{ archive_url }}", 
      "{{ include.type }}", 
      "{{ project_slug_last }}"
    );
  })();
</script>
