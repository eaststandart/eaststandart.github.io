{%- comment -%}
@about Оригинальный модуль вывода локального списка постов проекта с кнопками-стрелочками.
@purpose Отображает аккуратные строчки-ссылки и подключает JS-навигатор внутри карточки изделия.
@author TechLab
{%- endcomment -%}

<div class="posts-page-nav-container">
  <!-- Блок вывода стрелочек навигации локального списка -->
  <div class="posts-page-nav-buttons">
    <button id="posts-page-nav-prev" class="posts-page-nav-btn" disabled>&lt;</button>
    <span id="posts-page-nav-indicator" class="posts-page-nav-text">0 / 0</span>
    <button id="posts-page-nav-next" class="posts-page-nav-btn" disabled>&gt;</button>
  </div>

  <!-- Список аккуратных строчек-ссылок на публикации -->
  <ul id="posts-page-list" class="posts-page-list-wrapper">
    {%- assign project_slug = page.url | split: '/' | last -%}
    {%- assign counter = 0 -%}
    
    {%- for post in site.posts -%}
      {%- if post.categories contains project_slug -%}
        {%- assign counter = counter | plus: 1 -%}
        <li class="posts-page-item" data-index="{{ counter }}">
          <span class="posts-page-item-date">{{ post.date | date: "%d.%m.%Y" }}</span>
          <a href="{{ post.url | relative_url }}" class="posts-page-item-link">{{ post.title }}</a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

<!-- Подключаем оригинальный JS-скрипт управления стрелочками и локальной пагинацией -->
<script src="{{ '/assets/js/posts-page-nav.js' | relative_url }}"></script>

<script>
  // Инициализируем навигатор списка сразу после сборки страницы браузером
  document.addEventListener("DOMContentLoaded", function() {
    if (typeof initPostsPageNavigation === 'function') {
      initPostsPageNavigation();
    }
  });
</script>
