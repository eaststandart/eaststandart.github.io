{%- comment -%}
@about Модуль автоматического вывода локальных лент постов на страницах проектов.
@purpose Считает количество публикаций заданного posttype. Если они есть, выводит переданный заголовок header-h3
         и формирует список. Если постов нет — полностью скрывает блок вместе с заголовком.
@author TechLab
{%- endcomment -%}

{% assign url_parts = page.url | split: "/" %}
{% assign section_slug = url_parts[1] %}
{% assign real_project_slug = url_parts[2] %}

{% comment %} Считаем количество живых постов, реально подходящих под заданный тип контура {% endcomment %}
{% assign posts_count = 0 %}
{%- for post in site.categories[real_project_slug] -%}
  {%- if post.categories contains include.posttype -%}
    {% assign posts_count = posts_count | plus: 1 %}
  {%- endif -%}
{%- endfor -%}

{% comment %} БАРЬЕР ПУСТОТЫ: запускаем рендер только если в данной категории есть хотя бы один пост {% endcomment %}
{% if posts_count > 0 %}

  {% comment %} ЖЕЛЕЗНЫЙ СТРОЧНЫЙ ВЫВОД: рендерим чистый HTML-заголовок без переносов строк и лишних ID {% endcomment %}
  {% if include.header-h3 and include.header-h3 != "" %}<h3>{{ include.header-h3 }}</h3>{% endif %}

  {% comment %} Сборка чистых промышленных ID без тестового мусора -test- {% endcomment %}
  {% assign loop_id = include.posttype | append: "-" | append: real_project_slug %}
  {% assign ctrl_id = "ctrl-" | append: loop_id %}

  {% comment %} Вычисляем глубокий вложенный адрес архивной страницы под кнопку «0» {% endcomment %}
  {% assign archive_url = "/" | append: include.posttype | append: "/" | append: section_slug | append: "/" | append: real_project_slug | append: "/" %}

  <!-- 1. HTML-РАЗМЕТКА СПИСКА СТРОК И КОНТЕЙНЕРА ПАГИНАЦИИ -->
  <ul id="{{ loop_id }}" class="project-list posts-page-list">
    {%- for post in site.categories[real_project_slug] -%}
      {%- if post.categories contains include.posttype -%}
        {%- assign is_post = true -%}
        {%- if include.posttype == "media" -%}{%- assign is_post = false -%}{%- endif -%}
        <li class="local-post-item posts-page-item" data-date="{{ post.date | date: '%Y-%m-%d' }}" data-is-post="{{ is_post }}" data-emoji="">
          <div>
            <span>{{ post.date | date: "%d.%m.%Y" }}&nbsp;»&nbsp;</span>
            <span>
              <a href="{{ post.url | relative_url }}" class="item-link posts-page-link">
                {{ post.title }}
              </a>
            </span>
          </div>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  <!-- Изолированный блок кнопок управления локальной пагинацией -->
  <div id="{{ ctrl_id }}" class="posts-page-ctrl" style=""></div>

  <!-- 2. JAVASCRIPT-ЛОГИКА КЛИЕНТСКОЙ ПАГИНАЦИИ ДЛЯ ПРОЕКТОВ (ВНЕШНИЙ СКРИПТ) -->
  <script src="{{ '/assets/js/posts-page-nav.js' | relative_url }}"></script>

  <script>
    (function() {
      if (typeof runPostsPageNav === 'function') {
        runPostsPageNav(
          "{{ loop_id }}", 
          "{{ ctrl_id }}", 
          "{{ include.per_page }}", 
          "{{ archive_url }}", 
          "{{ include.posttype }}", 
          "{{ section_slug | append: '/' | append: real_project_slug }}"
        );
      }
    })();
  </script>

{% endif %}
