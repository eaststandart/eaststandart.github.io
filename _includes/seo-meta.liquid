{%- comment -%}
@module  seo-meta.liquid
@about   Модуль сборки SEO и Open Graph мета-тегов.
@purpose Формирование мета-тегов поисковых систем и превью для соцсетей. Исключает дублирование дескрипшенов, автоматически подбирает ключевые слова и адаптирует заголовки в мессенджерах по длине. Сохраняет оригинальный <title> страниц для стабильной работы комментариев и GitHub Discussions.
@author  TechLab
@version 1.0.0
{%- endcomment -%}

{%- assign final_keywords = page.metakeywords | default: site.keywords %}
{%- assign club_footer = site.club.title | default: "Детско-юношеский инженерный клуб г. Владивосток" %}
{%- assign club_short = site.club.title_short | default: "Инженерный клуб г. Владивосток" %}
{%- assign title_short = site.title_short | default: "Творческая лаборатория" %}
{%- assign default_alt = site.defaults[0].values.image.alt | default: "Радиотехника: техническое творчество учащихся" %}
{%- if page.url == '/' or page.url == '/index.html' %}
  {%- assign final_title = site.title %}
  {%- assign final_desc = page.description | append: " " | append: site.description %}
{%- elsif page.url contains '/faire/' %}
  {%- assign full_title_test = page.title | append: " | " | append: club_footer %}
  {%- assign string_length = full_title_test | size %}
  {%- if string_length > 70 %}
    {%- assign final_title = page.title | append: " | " | append: club_short %}
  {%- else %}
    {%- assign final_title = full_title_test %}
  {%- endif %}
  {%- assign final_desc = page.metadescription | default: page.description | default: site.description %}
{%- else %}
  {%- assign full_title_test = page.title | append: " | " | append: site.title %}
  {%- assign string_length = full_title_test | size %}
  {%- if string_length > 70 %}
    {%- assign final_title = page.title | append: " | " | append: title_short %}
  {%- else %}
    {%- assign final_title = full_title_test %}
  {%- endif %}
  {%- assign final_desc = page.metadescription | default: page.description | default: site.description %}
{%- endif %}
{%- if page.url == '/' or page.url == '/index.html' %}
<title>{{ site.title }}</title>
{%- else %}
<title>{{ page.title }}</title>
{%- endif %}
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}" />
<meta name="generator" content="Jekyll v{{ jekyll.version }}" />
<meta name="author" content="{{ site.author.name | default: 'TechLab' }}" />
{%- if final_desc %}
<meta name="description" content="{{ final_desc | strip_html | strip_newlines | escape }}" />
{%- endif %}
{%- if final_keywords %}
<meta name="keywords" content="{{ final_keywords | strip_html | strip_newlines | escape }}">
{%- endif %}
<meta property="og:locale" content="ru" />
<meta property="og:site_name" content="{{ site.title }}" />
<meta property="og:title" content="{{ final_title }}" />
<meta property="og:url" content="{{ page.url | replace: 'index.html', '' | absolute_url }}" />
<meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}" />
{%- if final_desc %}
<meta property="og:description" content="{{ final_desc | strip_html | strip_newlines | escape }}" />
{%- endif %}
{%- if site.image %}
<meta property="og:image" content="{{ site.image | absolute_url }}" />
<meta property="og:image:alt" content="{{ default_alt }}" />
{%- endif %}
<meta name="twitter:card" content="{{ site.twitter.card | default: 'summary_large_image' }}" />
<meta name="twitter:title" content="{{ final_title }}" />
{%- if final_desc %}
<meta name="twitter:description" content="{{ final_desc | strip_html | strip_newlines | escape }}" />
{%- endif %}
{%- if site.twitter.username %}
<meta name="twitter:site" content="@{{ site.twitter.username }}" />
{%- endif %}
{%- if site.author.name %}
<meta name="twitter:creator" content="@{{ site.author.name }}" />
{%- endif %}
{%- if site.image %}
<meta name="twitter:image" content="{{ site.image | absolute_url }}" />
<meta name="twitter:image:alt" content="{{ default_alt }}" />
{%- endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "url": "{{ site.url }}",
  "logo": "{{ site.image | absolute_url }}",
  {% if site.author.email %}"email": "{{ site.author.email }}",{% endif %}
  "sameAs": [
    "{{ site.author.github_profile }}",
    "{{ site.author.telegram_contact }}"
  ],
  "department": {
    "@type": "EducationalOrganization",
    "name": "{{ club_footer }}",
    "alternateName": "{{ site.club.title_alternate | default: 'Детский инженерный club г. Владивосток' }}",
    "description": "{{ site.club.description }}",
    "url": "{{ site.url }}",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "{{ site.club.region | default: 'Приморский край' }}",
      "addressLocality": "{{ site.club.location | default: 'г. Владивосток' }}",
      "addressCountry": "RU"
    },
    "sameAs": [
      "{{ site.club.telegram_channel }}"
    ]
  }
}
</script>
