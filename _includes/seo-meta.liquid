{%- comment -%}
@module  seo-meta.liquid
@about   Автоматизированный модуль сборки SEO и Open Graph мета-тегов.
@purpose Каскадный выбор тегов без дублирования. Автоматический подсчет длины строк (Unicode, лимит 70), синхронизация <title> и og:title, а также каскадная поддержка индивидуальных картинок страниц через metaimage (включая форматы webp/png/jpg).
@author  TechLab
@version 2.3.0
{%- endcomment -%}
{%- assign final_keywords = page.metakeywords | default: page.keywords | default: site.keywords -%}
{%- assign club_footer = site.club | default: "Детско-юношеский инженерный клуб г. Владивосток" -%}
{%- assign club_short = site.club_short | default: "Инженерный клуб г. Владивосток" -%}
{%- assign title_short = site.title_short | default: "Творческая лаборатория" -%}
{%- assign default_alt = "Радиотехника: техническое творчество учащихся" -%}
{%- comment -%} АВТОМАТИЧЕСКОЕ ВЫЧИСЛЕНИЕ ДЛИНЫ И ФОРМИРОВАНИЕ ЗАГОЛОВКОВ {%- endcomment -%}
{%- if page.url == '/' or page.url == '/index.html' -%}
  {%- assign final_title = site.title -%}
  {%- assign final_desc = page.description | append: " " | append: site.description -%}
  {%- assign final_og_image = site.image | absolute_url -%}
{%- else -%}
  {%- assign full_title_test = page.title | append: " | " | append: site.title -%}
  {%- assign string_length = full_title_test | size -%}
  {%- if page.url contains '/faire/' -%}
    {%- assign full_title_test = page.title | append: " | " | append: club_footer -%}
    {%- assign string_length = full_title_test | size -%}
    {%- if string_length > 70 -%}
      {%- assign final_title = page.title | append: " | " | append: club_short -%}
    {%- else -%}
      {%- assign final_title = full_title_test -%}
    {%- endif -%}
  {%- else -%}
    {%- if string_length > 70 -%}
      {%- assign final_title = page.title | append: " | " | append: title_short -%}
    {%- else -%}
      {%- assign final_title = full_title_test -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign page_pure_desc = page.metadescription | default: page.description | default: site.description -%}
  {%- assign final_desc = page_pure_desc | append: " | " | append: club_footer -%}
  {%- assign selected_image = page.metaimage | default: site.image -%}
  {%- assign final_og_image = selected_image | absolute_url -%}
{%- endif -%}
<title>{{ final_title }}</title>
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}" />
<meta name="generator" content="Jekyll v{{ jekyll.version }}" />
<meta name="author" content="{{ site.author.name | default: 'TechLab' }}" />
{%- if final_desc %}
<meta name="description" content="{{ final_desc | strip_html | strip_newlines | escape }}" />
{%- endif -%}
{%- if final_keywords %}
<meta name="keywords" content="{{ final_keywords | strip_html | strip_newlines | escape }}">
{%- endif -%}
<meta property="og:locale" content="ru" />
<meta property="og:site_name" content="{{ site.title }}" />
<meta property="og:title" content="{{ final_title }}" />
<meta property="og:url" content="{{ page.url | replace: 'index.html', '' | absolute_url }}" />
<meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}" />
{%- if final_desc %}
<meta property="og:description" content="{{ final_desc | strip_html | strip_newlines | escape }}" />
{%- endif -%}
<meta property="og:image" content="{{ final_og_image }}" />
<meta property="og:image:alt" content="{{ default_alt }}" />
<meta name="twitter:card" content="{{ site.twitter.card | default: 'summary_large_image' }}" />
<meta name="twitter:title" content="{{ final_title }}" />
{%- if final_desc %}
<meta name="twitter:description" content="{{ final_desc | strip_html | strip_newlines | escape }}" />
{%- endif -%}
{%- if site.twitter.username %}
<meta name="twitter:site" content="@{{ site.twitter.username }}" />
{%- endif -%}
{%- if site.author.name %}
<meta name="twitter:creator" content="@{{ site.author.name }}" />
{%- endif -%}
<meta name="twitter:image" content="{{ final_og_image }}" />
<meta name="twitter:image:alt" content="{{ default_alt }}" />
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "{{ club_footer }}",
  "alternativeName": "{{ site.title }}",
  "description": "{{ site.description }}",
  "url": "{{ site.url }}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "{{ site.author.location | default: 'г. Владивосток' }}",
    "addressCountry": "RU"
  }
}
</script>
