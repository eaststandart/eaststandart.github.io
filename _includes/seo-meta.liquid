{%- comment -%}
@module  seo-meta.liquid (TEST LOG EDITION)
@about   Тестовый модуль для замера реального поведения счетчика .size на GitHub Pages.
@author  TechLab
@version 9.9.9
{%- endcomment -%}

{%- assign club_footer = site.club | default: "Детско-юношеский инженерный клуб г. Владивосток" -%}
{%- assign club_short = site.club_short | default: "Инженерный клуб г. Владивосток" -%}
{%- assign title_short = site.title_short | default: "Творческая лаборатория" -%}

{%- comment -%} 1. ЗАМЕРЫ ЧИСТЫХ СТРОК {%- endcomment -%}
{%- assign len_page_title = page.title | size -%}
{%- assign len_club_footer = club_footer | size -%}
{%- assign len_site_title = site.title | size -%}

{%- comment -%} 2. ЗАМЕРЫ СТРОК ПОСЛЕ СТАНДАРТНОЙ СЛИВНОЙ ОЧИСТКИ {%- endcomment -%}
{%- assign clean_page_title = page.title | strip_html -%}
{%- assign len_clean_title = clean_page_title | size -%}

{%- comment -%} 3. СБОРКА ТЕСТОВЫХ СУММАРНЫХ СТРОК {%- endcomment -%}
{%- assign full_title_faire = page.title | append: " | " | append: club_footer -%}
{%- assign len_full_faire = full_title_faire | size -%}

{%- assign full_title_other = page.title | append: " | " | append: site.title -%}
{%- assign len_full_other = full_title_other | size -%}

<!-- 
    ======================================================================
    ТЕХНИЧЕСКИЙ ЛОГ РАБОТЫ LIQUID ДЛЯ СТРАНИЦЫ: "{{ page.title }}"
    ======================================================================
    [ЧИСТЫЕ СТРОКИ И ИХ .SIZE]:
    - Длина page.title: {{ len_page_title }}
    - Длина site.title: {{ len_site_title }}
    - Длина club_footer: {{ len_club_footer }}
    
    [ПОСЛЕ ФИЛЬТРА STRIP_HTML]:
    - Длина page.title (| strip_html): {{ len_clean_title }}
    
    [СУММАРНЫЕ СТРОКИ ДЛЯ СРАВНЕНИЯ]:
    - Полная строка для FAIRE (Заголовок + Клуб): "{{ full_title_faire }}"
    - Ее итоговый .size: {{ len_full_faire }}
    
    - Полная строка для ОСТАЛЬНЫХ (Заголовок + Сайт): "{{ full_title_other }}"
    - Ее итоговый .size: {{ len_full_other }}
    ======================================================================
-->

{%- comment -%} ПОДСТАНОВКА ВРЕМЕННЫХ ТЕГОВ, ЧТОБЫ СБОРКА НЕ ПАДАЛА {%- endcomment -%}
<title>TEST LOG | {{ page.title }}</title>
<meta name="x-test-page-title-size" content="{{ len_page_title }}" />
<meta name="x-test-full-faire-size" content="{{ len_full_faire }}" />
<meta name="x-test-full-other-size" content="{{ len_full_other }}" />
