---
layout: null
permalink: /sitemapvideo.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://sitemaps.org"
        xmlns:video="http://google.com">
  {% for file in site.static_files %}
    {% if file.extname == '.webm' and file.path contains '/faire/' %}
      {% unless file.path contains '/test/' %}
        {% assign folder_path = file.path | remove: file.name %}
        {% assign target_page = nil %}
        {% for p in site.pages %}
          {% if p.url == folder_path %}
            {% assign target_page = p %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if target_page %}
          {% assign slug = target_page.name | remove: '.md' %}
          {% assign main_thumb = folder_path | append: slug | append: '.webp' %}
  <url>
    <loc>{{ target_page.url | absolute_url }}</loc>
    <video:video>
      <video:thumbnail_loc>{{ main_thumb | absolute_url }}</video:thumbnail_loc>
      <video:title>{{ target_page.title | default: file.basename | xml_escape }} — видео ({{ file.basename }})</video:title>
      <video:description>{{ target_page.description | default: target_page.excerpt | default: target_page.title | strip_html | strip_newlines | truncate: 200 | xml_escape }}</video:description>
      <video:content_loc>{{ file.path | absolute_url }}</video:content_loc>
    </video:video>
  </url>
        {% endif %}
      {% endunless %}
    {% endif %}
  {% endfor %}
</urlset>
