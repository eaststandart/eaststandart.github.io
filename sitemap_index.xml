---
layout: null
permalink: /sitemap_index.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://sitemaps.org">
  
  <!-- 1. Добавляем главную страницу -->
  <url>
    <loc>{{ site.url }}/</loc>
    <priority>1.0</priority>
  </url>

  <!-- 2. Цикл для обычных страниц (если они есть) -->
  {% for page in site.pages %}
    {% unless page.url contains '.xml' or page.url contains '.css' or page.url contains '.txt' or page.url == '/' %}
    <url>
      <loc>{{ site.url }}{{ page.url | replace: 'index.html', '' }}</loc>
      <priority>0.8</priority>
    </url>
    {% endunless %}
  {% endfor %}

  <!-- 3. ТОТ САМЫЙ ЦИКЛ: собирает все ваши папки (engineers, media, question, journal) -->
  {% for collection in site.collections %}
    {% for doc in collection.docs %}
    <url>
      <loc>{{ site.url }}{{ doc.url }}</loc>
      <priority>0.7</priority>
    </url>
    {% endfor %}
  {% endfor %}

</urlset>
